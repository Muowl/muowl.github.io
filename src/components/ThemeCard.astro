---
import type { ThemeEntry } from '../data/themes';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  theme: ThemeEntry;
  lang: Lang;
}

const { theme, lang } = Astro.props;
const t = useTranslations(lang);
const href = localePath(lang, `/themes/${theme.slug}/`);
---

<a class="theme-card" href={href}>
  <div class="strip" aria-hidden="true">
    {theme.strip.map((hex) => <span style={`background:${hex}`} />)}
  </div>
  <div class="body">
    <div class="top">
      <h3>{theme.name}</h3>
      <span class="version">v{theme.version}</span>
    </div>
    <p class="tagline">{theme.tagline[lang]}</p>
    <p class="summary">{theme.summary[lang]}</p>
    <div class="facts">
      <span>{theme.tokenCount} {t('themes.tokens')}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span>{theme.flavorCount} {t('themes.flavors')}</span>
    </div>
  </div>
</a>

<style>
  .theme-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--velvet);
    border: 1px solid rgba(var(--carmine-rgb), 0.12);
    border-radius: 1.2rem;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .theme-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--carmine-rgb), 0.45);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.7);
  }

  .strip {
    display: flex;
    height: 64px;
  }
  .strip span {
    flex: 1;
  }

  .body {
    padding: 1.3rem 1.5rem 1.5rem;
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .version {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash-mauve);
  }

  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--wisteria);
    margin-top: 0.15rem;
  }

  .summary {
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(var(--pearl-rgb), 0.72);
    margin-top: 0.8rem;
  }

  .facts {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ash-mauve);
  }
  .facts .dot {
    opacity: 0.6;
  }
</style>
