---
import type { ThemeEntry } from '../data/themes';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  theme: ThemeEntry;
  lang: Lang;
}

const { theme, lang } = Astro.props;
const t = useTranslations(lang);
const href = localePath(lang, `/themes/${theme.slug}/`);
---

<a class="theme-card" href={href} style={`--card-accent:${theme.accent}`}>
  <div class="strip" aria-hidden="true">
    {theme.strip.map((hex) => <span style={`background:${hex}`} />)}
  </div>
  <div class="body">
    <div class="top">
      <h3>{theme.name}</h3>
      <span class="version">
        {!theme.published && <span class="wip">{theme.pendingLabel?.[lang] ?? t('theme.wip')}</span>}
        v{theme.version}
      </span>
    </div>
    <p class="tagline">{theme.tagline[lang]}</p>
    <p class="summary">{theme.summary[lang]}</p>
    <div class="facts">
      <span>{theme.tokenCount} {theme.tokenLabel?.[lang] ?? t('themes.tokens')}</span>
      {
        theme.flavorCount > 1 && (
          <>
            <span class="dot" aria-hidden="true">
              ·
            </span>
            <span>
              {theme.flavorCount} {t('themes.flavors')}
            </span>
          </>
        )
      }
    </div>
    <span class="card-link">{t('themes.view')} <span aria-hidden="true">↗</span></span>
  </div>
</a>

<style>
  .theme-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--velvet);
    border: var(--border-panel);
    border-radius: var(--radius-panel);
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .theme-card:hover {
    transform: translateY(-3px);
    border-color: var(--card-accent);
    box-shadow: 0 12px 28px -20px rgba(var(--crypt-rgb), .8);
  }

  .strip {
    display: flex;
    height: 80px;
    flex-shrink: 0;
    border-bottom: var(--border-panel);
  }
  .strip span {
    flex: 1;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.5rem 1.5rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .version {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ash-mauve);
    white-space: normal;
  }

  .wip {
    display: inline-block;
    margin-right: 0.45rem;
    padding: 0.1rem 0.5rem;
    border-radius: 0;
    background: rgba(var(--carmine-rgb), 0.15);
    border: 1px solid rgba(var(--carmine-rgb), 0.4);
    color: var(--carmine);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: var(--text-small);
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--wisteria);
    margin-top: 0.55rem;
  }

  .summary {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(var(--pearl-rgb), 0.84);
    text-wrap: pretty;
    margin-top: 0.8rem;
  }

  .facts {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ash-mauve);
  }
  .card-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-top: 1rem;
    padding-top: .75rem;
    border-top: var(--border-panel);
    font: 500 var(--text-caption)/1.5 var(--font-mono);
    color: var(--pearl);
  }
  .theme-card:hover .card-link { color: var(--card-accent); }
  .facts .dot {
    opacity: 0.6;
  }
  @media (min-width: 681px) and (max-width: 980px) {
    .theme-card { display: grid; grid-template-columns: 5rem minmax(0, 1fr); }
    .strip { flex-direction: column; height: auto; border-bottom: 0; border-right: var(--border-panel); }
  }
  @media (max-width: 680px) {
    .strip { height: 64px; }
    .body { padding: 1.25rem; }
  }
</style>
