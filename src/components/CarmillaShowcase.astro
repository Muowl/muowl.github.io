---
/** As cores vêm do TOML; a prévia usa os tokens TextMate exportados pelo tema. */
import { tokens, flavors, themeColor, FLAVOR_IDS } from '../lib/palette';
import previewTokens from '../data/carmilla.preview.tokens.json';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/ui';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const flavorList = flavors();
const flavorTokens = FLAVOR_IDS.map(id => ({ id, tokens: tokens(id) }));
const rows = tokens('base').map((token, index) => ({
  ...token,
  variants: flavorTokens.map(flavor => ({ id: flavor.id, ...flavor.tokens[index] })),
}));
const themeColors = Object.fromEntries(FLAVOR_IDS.map(id => [id, themeColor(id)]));
const escape = (text: string) => text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');
const code = previewTokens.map(line => line.map(token =>
  `<span style="color:var(--${token.role})${token.italic ? ';font-style:italic' : ''}">${escape(token.text)}</span>`
).join('')).join('\n');
const gutter = previewTokens.map((_, i) => ({ n: i + 1 }));

---

<!-- ============== PALETA ============== -->
<section>
  <div class="section-head">
    <div class="section-num">I.</div>
    <h2 class="section-title">{t('theme.palette.title')}</h2>
  </div>
  <p class="section-subtitle">{t('theme.palette.subtitle')}</p>

  <div class="palette">
    {
      rows.map((tk) => (
        <div class="swatch">
          <div class="swatch-color" style={`background: var(--${tk.key})`}>
            <span class="swatch-hex" class:list={[{ scrim: !tk.dark }]}>
              {tk.variants.map(variant => <span class={`fl-${variant.id}`}>{variant.hex}</span>)}
            </span>
          </div>
          <div class="swatch-meta">
            <div class="swatch-name">
              {tk.variants.map(variant => <span class={`fl-${variant.id}`}>{variant.name}</span>)}
            </div>
            <div class="swatch-role" set:html={tk.role[lang]} />
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- ============== EDITOR ============== -->
<section>
  <div class="section-head">
    <div class="section-num">II.</div>
    <h2 class="section-title">{t('theme.editor.title')}</h2>
  </div>
  <p class="section-subtitle">{t('theme.editor.subtitle')}</p>

  <div class="editor">
    <div class="editor-titlebar">
      <span class="traffic r" aria-hidden="true"></span>
      <span class="traffic y" aria-hidden="true"></span>
      <span class="traffic g" aria-hidden="true"></span>
      <span class="file">carmilla / <strong>countess.ts</strong></span>
    </div>
    <div class="editor-tabs">
      <div class="editor-tab active"><span class="dot"></span> countess.ts</div>
      <div class="editor-tab">palette.css</div>
      <div class="editor-tab">README.md</div>
    </div>
    <div class="editor-body">
      <div class="gutter" aria-hidden="true">
        {gutter.map((g) => <div class="ln">{g.n}</div>)}
      </div>
      <div class="code-area" tabindex="0" aria-label={lang === 'pt' ? 'Prévia TypeScript' : 'TypeScript preview'}>
        <pre><code set:html={code} /></pre>
      </div>
    </div>
    <div class="editor-statusbar">
      <span class="branch">⎇ main</span>
      <span>↑ 2 ↓ 0</span>
      <span><span style="color:var(--pomegranate);" aria-hidden="true">●</span> 0 errors</span>
      <span style="color:var(--peach-velvet);">▲ 1 warning</span>
      <div class="right">
        <span>Ln <strong>21</strong>, Col <strong>9</strong></span>
        <span>Spaces: <strong>4</strong></span>
        <span>UTF-8</span>
        <span><strong>TypeScript</strong></span>
        <span
          ><strong style="color:var(--carmine);">{flavorList.map(flavor => <span class={`fl-${flavor.id}`}>{flavor.name}</span>)}</strong></span
        >
      </div>
    </div>
  </div>
</section>

<!-- ============== ANATOMIA ============== -->
<section>
  <div class="section-head">
    <div class="section-num">III.</div>
    <h2 class="section-title">{t('theme.anatomy.title')}</h2>
  </div>
  <p class="section-subtitle">{t('theme.anatomy.subtitle')}</p>

  <div class="token-map">
    <div class="token-row">
      <span class="token-dot" style="background:var(--carmine)"></span>
      <span class="token-name">keyword</span>
      <span class="token-sample"><span style="color:var(--carmine)">const</span> x = <span style="color:var(--champagne)">"…"</span></span>
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--wisteria)"></span>
      <span class="token-name">variable.lang</span>
      <span class="token-sample"
        ><span style="color:var(--wisteria);font-style:italic">this</span>.name</span
      >
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--verdigris)"></span>
      <span class="token-name">entity.type</span>
      <span class="token-sample">: <span style="color:var(--verdigris)">string</span></span>
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--absinthe)"></span>
      <span class="token-name">entity.function</span>
      <span class="token-sample"><span style="color:var(--absinthe)">log</span>()</span>
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--champagne)"></span>
      <span class="token-name">string</span>
      <span class="token-sample"><span style="color:var(--champagne)">"Carmilla"</span></span>
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--peach-velvet)"></span>
      <span class="token-name">constant.numeric</span>
      <span class="token-sample"><span style="color:var(--peach-velvet)">42</span></span>
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--pomegranate)"></span>
      <span class="token-name">invalid</span>
      <span class="token-sample"><span style="color:var(--pomegranate)">undefined_var</span></span>
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--ash-mauve)"></span>
      <span class="token-name">comment</span>
      <span class="token-sample"
        ><span style="color:var(--ash-mauve);font-style:italic">// ash mauve</span></span
      >
    </div>
    <div class="token-row">
      <span class="token-dot" style="background:var(--pearl)"></span>
      <span class="token-name">variable</span>
      <span class="token-sample"><span style="color:var(--pearl)">guest</span></span>
    </div>
  </div>
</section>

<!-- ============== FLAVORS ============== -->
<section>
  <div class="section-head">
    <div class="section-num">IV.</div>
    <h2 class="section-title">{t('theme.flavors.title')}</h2>
  </div>
  <p class="section-subtitle">{t('theme.flavors.subtitle')}</p>

  <p class="lead-text">{t('theme.flavors.lead')}</p>

  <div class="flavors-grid">
    {
      flavorList.map((f) => (
        <button type="button" class="flavor-card" data-set-flavor={f.id}>
          <div class="flavor-top">
            <span class="flavor-name">{f.name}</span>
            <span class="flavor-state">{t('theme.flavors.active')}</span>
          </div>
          <div class="strip" aria-hidden="true">
            {f.strip.map((hex) => (
              <span style={`background:${hex}`} />
            ))}
          </div>
          <div class="flavor-mood">
            {f.mood[lang]}{' '}
            <span class="flavor-hex" style={`color:${f.accent}`}>
              {f.accent}
            </span>
          </div>
        </button>
      ))
    }
  </div>
</section>

<script is:inline define:vars={{ themeColors }}>
  // O mesmo controle atende ao seletor do topo e aos cards de variantes.
  const root = document.documentElement;
  const buttons = document.querySelectorAll('[data-set-flavor]');
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  function applyFlavor(value) {
    const flavor = Object.hasOwn(themeColors, value) ? value : 'base';
    root.dataset.flavor = flavor;
    try { localStorage.setItem('carmilla-flavor', flavor); } catch {}
    if (themeMeta) themeMeta.setAttribute('content', themeColors[flavor]);
    buttons.forEach(button => {
      const active = button.dataset.setFlavor === flavor;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  }
  buttons.forEach(button => button.addEventListener('click', () => applyFlavor(button.dataset.setFlavor)));
  applyFlavor(root.dataset.flavor);
</script>

<style>
  /* Só o texto da variante ativa aparece nos swatches e na barra do editor. */
  .fl-base, .fl-amethyst, .fl-moonstone { display: none; }
  :global([data-flavor='base']) .fl-base,
  :global([data-flavor='amethyst']) .fl-amethyst,
  :global([data-flavor='moonstone']) .fl-moonstone { display: inline; }
  .flavor-card:focus-visible, .code-area:focus-visible {
    outline: 2px solid var(--carmine);
    outline-offset: 3px;
  }

  /* ============== PALETA ============== */
  .palette {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.2rem;
  }

  .swatch {
    background: var(--velvet);
    border-radius: var(--radius-panel);
    overflow: hidden;
    border: var(--border-panel);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    position: relative;
  }

  .swatch:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--carmine-rgb), 0.45);
    box-shadow: 0 12px 28px -20px rgba(var(--crypt-rgb), .8);
  }

  .swatch-color {
    height: 140px;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .swatch-hex {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 500;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-control);
    backdrop-filter: blur(8px);
    background: rgba(var(--crypt-rgb), 0.55);
    color: var(--pearl);
    border: 1px solid rgba(var(--pearl-rgb), 0.18);
    letter-spacing: 0.5px;
  }
  /* Sobre um token claro o chip precisa de fundo mais opaco para não sumir. */
  .swatch-hex.scrim {
    background: rgba(var(--crypt-rgb), 0.7);
  }

  .swatch-meta {
    padding: 1rem 1.1rem 1.2rem;
  }

  .swatch-name {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
  }

  .swatch-role {
    font-size: 0.875rem;
    color: var(--pearl);
    line-height: 1.65;
  }
  .swatch-role :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--carmine);
  }

  /* ============== EDITOR ============== */
  .editor {
    background: var(--boudoir);
    border-radius: var(--radius-panel);
    overflow: hidden;
    box-shadow:
      0 50px 100px -20px rgba(0, 0, 0, 0.7),
      0 30px 60px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(var(--carmine-rgb), 0.18),
      inset 0 1px 0 rgba(var(--pearl-rgb), 0.04);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    margin-top: 1rem;
  }

  .editor-titlebar {
    background: var(--crypt);
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(var(--carmine-rgb), 0.1);
  }

  .traffic {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .traffic.r {
    background: var(--pomegranate);
  }
  .traffic.y {
    background: var(--champagne);
  }
  .traffic.g {
    background: var(--absinthe);
  }

  .editor-titlebar .file {
    margin-left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash-mauve);
  }
  .editor-titlebar .file strong {
    color: var(--pearl);
    font-weight: 500;
  }

  .editor-tabs {
    background: var(--tabstrip);
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(var(--carmine-rgb), 0.08);
    padding-left: 0.5rem;
  }

  .editor-tab {
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash-mauve);
    border-right: 1px solid rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .editor-tab.active {
    background: var(--boudoir);
    color: var(--pearl);
    border-top: 2px solid var(--carmine);
    padding-top: calc(0.7rem - 2px);
  }

  .editor-tab .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--wisteria);
  }

  .editor-body {
    display: grid;
    min-width: 0;
    grid-template-columns: 50px minmax(0, 1fr);
    min-height: 480px;
  }

  .gutter {
    background: var(--crypt);
    padding: 1.2rem 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash-mauve);
    user-select: none;
    line-height: 1.65;
  }

  .gutter .ln {
    padding: 0 0.7rem;
    position: relative;
  }
  .gutter .ln.modified::before,
  .gutter .ln.added::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
  }
  .gutter .ln.modified::before {
    background: var(--wisteria);
  }
  .gutter .ln.added::before {
    background: var(--absinthe);
  }
  .gutter .ln.active {
    color: var(--peach-velvet);
  }

  .code-area {
    padding: 1.2rem 1.2rem 1.2rem 0.5rem;
    min-width: 0;
    overflow-x: auto;
    position: relative;
  }

  pre {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--pearl);
    tab-size: 4;
    position: relative;
  }

  pre :global(.current-line) {
    background: rgba(var(--selection-rgb), 0.55);
    display: block;
    margin: 0 -1.2rem 0 -0.5rem;
    padding: 0 1.2rem 0 0.5rem;
    border-left: 2px solid var(--carmine);
    padding-left: calc(0.5rem - 2px);
  }

  pre :global(.c) {
    color: var(--ash-mauve);
    font-style: italic;
  }
  pre :global(.k) {
    color: var(--carmine);
  }
  pre :global(.i) {
    color: var(--wisteria);
    font-style: italic;
  }
  pre :global(.t) {
    color: var(--verdigris);
  }
  pre :global(.f) {
    color: var(--absinthe);
  }
  pre :global(.s) {
    color: var(--champagne);
  }
  pre :global(.n) {
    color: var(--peach-velvet);
  }
  pre :global(.err) {
    color: var(--pomegranate);
  }
  pre :global(.p) {
    color: var(--pearl);
  }
  pre :global(.punc) {
    color: var(--pearl);
  }

  .editor-statusbar {
    background: var(--velvet);
    padding: 0.35rem 1rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--pearl);
    border-top: 1px solid rgba(var(--carmine-rgb), 0.12);
  }
  .editor-statusbar .branch {
    color: var(--carmine);
  }
  .editor-statusbar .right {
    margin-left: auto;
    display: flex;
    gap: 1.2rem;
    color: var(--pearl);
  }
  .editor-statusbar .right span strong {
    color: var(--pearl);
    font-weight: 500;
  }

  /* ============== TOKEN MAP ============== */
  .token-map {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 0.6rem;
    background: var(--velvet);
    padding: 1.5rem;
    border-radius: var(--radius-panel);
    border: var(--border-panel);
  }
  .token-row {
    display: grid;
    grid-template-columns: 14px minmax(0, 110px) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-control);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    transition: background 0.2s;
  }
  .token-row:hover {
    background: rgba(var(--carmine-rgb), 0.06);
  }
  .token-dot {
    width: 14px;
    height: 14px;
    border-radius: 4px;
  }
  .token-name {
    color: var(--pearl);
  }
  .token-sample {
    color: var(--pearl);
    overflow-wrap: anywhere;
    background: var(--crypt);
    border-radius: var(--radius-control);
    padding: .2rem .3rem;
  }

  /* ============== FLAVOR CARDS ============== */
  .flavors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 1.2rem;
  }
  .flavor-card {
    text-align: left;
    cursor: pointer;
    background: var(--velvet);
    border: var(--border-panel);
    border-radius: var(--radius-panel);
    padding: 1.4rem 1.5rem 1.3rem;
    font-family: var(--font-body);
    color: var(--pearl);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .flavor-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--carmine-rgb), 0.45);
    box-shadow: 0 12px 28px -20px rgba(var(--crypt-rgb), .8);
  }
  .flavor-card.active {
    border-color: rgba(var(--carmine-rgb), 0.65);
    box-shadow: 0 0 0 1px rgba(var(--carmine-rgb), .35);
  }
  .flavor-card .flavor-top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .flavor-card .flavor-name {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .flavor-card .flavor-state {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--carmine);
    white-space: nowrap;
    display: none;
  }
  .flavor-card.active .flavor-state {
    display: inline;
  }
  .flavor-card .strip {
    display: flex;
    height: 36px;
    border-radius: var(--radius-control);
    overflow: hidden;
    margin: 0.95rem 0 0.8rem;
    border: 1px solid rgba(var(--pearl-rgb), 0.1);
  }
  .flavor-card .strip span {
    flex: 1;
  }
  .flavor-card .flavor-mood {
    font-size: 0.9375rem;
    color: var(--pearl);
    line-height: 1.7;
  }
  .flavor-card .flavor-hex {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--crypt);
    border-radius: var(--radius-control);
    padding: .2rem .3rem;
  }

  @media (max-width: 680px) {
    .palette {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }
    .swatch-color {
      height: 100px;
    }
    .editor-body {
      grid-template-columns: 32px minmax(0, 1fr);
    }
    .gutter .ln {
      padding: 0 0.4rem;
      font-size: 0.7rem;
    }
    pre {
      font-size: 0.72rem;
    }
    .editor-statusbar {
      flex-wrap: wrap;
      gap: 0.6rem;
      font-size: 0.65rem;
    }
    .editor-statusbar .right {
      margin-left: 0;
      flex-wrap: wrap;
      gap: .6rem;
    }
  }
</style>
