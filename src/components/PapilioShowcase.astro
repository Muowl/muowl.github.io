---
/**
 * Showcase do Papilio.
 *
 * Tudo aqui sai de `lib/papilio` — hexes, razões de contraste e o mapa de papéis
 * vêm do YAML e do cálculo WCAG. As seções ficam dentro de `.papilio`, que carrega
 * as variáveis do tema e o próprio fundo: mostrar as cores sobre o boudoir do
 * Carmilla mentiria justamente sobre o contraste que a página afirma medir.
 */
import { swatches, anchorPairs, syntaxRoles, papilioCss, BG } from '../lib/papilio';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/ui';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tokens = swatches();
const pairs = anchorPairs();
const roles = syntaxRoles();
---

<style is:global set:html={papilioCss()}></style>

<!-- ============== PALETA ============== -->
<section>
  <div class="section-head">
    <div class="section-num">I.</div>
    <h2 class="section-title">{t('theme.palette.title')}</h2>
  </div>
  <p class="section-subtitle">{tokens.length} tokens</p>

  <div class="papilio panel">
    <div class="grid">
      {
        tokens.map((tk) => (
          <div class="swatch">
            <div class="chip" style={`background:${tk.hex}`} />
            <div class="meta">
              <div class="name">
                {tk.key}
                {tk.ratio && (
                  <span class:list={['ratio', tk.level === 'fail' ? 'bad' : 'ok']}>{tk.ratio}</span>
                )}
              </div>
              <div class="hex">{tk.hex}</div>
              <div class="role">{tk.label[lang]}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ============== ÂNCORAS ============== -->
<section>
  <div class="section-head">
    <div class="section-num">II.</div>
    <h2 class="section-title">{t('theme.anchors.title')}</h2>
  </div>
  <p class="section-subtitle">{t('theme.anchors.subtitle')}</p>
  <p class="lead-text">{t('theme.anchors.lead')}</p>

  <div class="papilio panel">
    <div class="pairs">
      {
        pairs.map((p) => (
          <div class="pair">
            <div class="side">
              <span class="side-label">{t('theme.anchors.raw')}</span>
              <span class="dot" style={`background:${p.anchor.hex}`} />
              <span class="side-hex">{p.anchor.hex}</span>
              <span class:list={['ratio', p.anchor.level === 'fail' ? 'bad' : 'ok']}>
                {p.anchor.ratio}
              </span>
              <span class="side-key">{p.anchor.key}</span>
            </div>
            <div class="arrow" aria-hidden="true">→</div>
            <div class="side">
              <span class="side-label">{t('theme.anchors.adjusted')}</span>
              <span class="dot" style={`background:${p.token.hex}`} />
              <span class="side-hex">{p.token.hex}</span>
              <span class:list={['ratio', p.token.level === 'fail' ? 'bad' : 'ok']}>
                {p.token.ratio}
              </span>
              <span class="side-key">{p.token.key}</span>
            </div>
            <p class="note">{p.note[lang]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ============== PAPÉIS ============== -->
<section>
  <div class="section-head">
    <div class="section-num">III.</div>
    <h2 class="section-title">{t('theme.roles.title')}</h2>
  </div>
  <p class="section-subtitle">{t('theme.roles.subtitle')}</p>

  <div class="papilio panel">
    <div class="roles">
      {
        roles.map((r) => (
          <div class="role-row">
            <span class="role-dot" style={`background:${r.hex}`} />
            <span class="role-name" style={`color:${r.hex}`}>
              {r.role}
            </span>
            <span class="role-token">{r.token}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style define:vars={{ papilioBg: BG }}>
  .panel {
    background: var(--papilioBg);
    border-radius: 1.2rem;
    padding: 1.8rem;
    border: 1px solid rgba(var(--pearl-rgb), 0.08);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
    overflow-x: auto;
  }

  /* ---------- swatches ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 0.9rem;
  }

  .swatch {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem;
    border-radius: 0.7rem;
    background: var(--pp-bg1);
  }

  .chip {
    width: 42px;
    height: 42px;
    border-radius: 0.5rem;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .meta {
    min-width: 0;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--pp-fg0);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .hex {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--pp-fg1);
    margin-top: 0.1rem;
  }

  .role {
    font-size: 0.72rem;
    color: var(--pp-muted);
    margin-top: 0.2rem;
    line-height: 1.35;
  }

  .ratio {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ratio.ok {
    color: var(--pp-success);
    border: 1px solid color-mix(in srgb, var(--pp-success) 45%, transparent);
  }
  .ratio.bad {
    color: var(--pp-warning);
    border: 1px solid color-mix(in srgb, var(--pp-warning) 45%, transparent);
  }

  /* ---------- âncora → token ---------- */
  .pairs {
    display: grid;
    gap: 0.6rem;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 0.7rem;
    background: var(--pp-bg1);
  }

  .side {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .side-label {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pp-muted);
    min-width: 3.6rem;
  }

  .dot {
    width: 22px;
    height: 22px;
    border-radius: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .side-hex {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--pp-fg0);
  }

  .side-key {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--pp-muted);
  }

  .arrow {
    color: var(--pp-crimson);
    font-size: 1.1rem;
  }

  .note {
    grid-column: 1 / -1;
    font-size: 0.78rem;
    color: var(--pp-muted);
    line-height: 1.5;
    margin-top: 0.1rem;
  }

  /* ---------- papéis ---------- */
  .roles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.35rem;
  }

  .role-row {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .role-row:hover {
    background: var(--pp-bg2);
  }

  .role-dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }

  .role-token {
    font-size: 0.68rem;
    color: var(--pp-muted);
  }

  @media (max-width: 680px) {
    .panel {
      padding: 1rem;
    }
    .pair {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .arrow {
      transform: rotate(90deg);
      justify-self: start;
    }
  }
</style>
