---
/**
 * 404 real — o GitHub Pages serve `dist/404.html` com status 404 de verdade para
 * qualquer rota desconhecida. Não é localizado: como a URL errada pode estar em
 * qualquer idioma, a página fala os dois.
 */
import { paletteCss, themeColor } from '../lib/palette';
import { ui } from '../i18n/ui';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor('base')} />
    <meta name="robots" content="noindex" />
    <title>404 — muowl</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global set:html={paletteCss()}></style>

    {/* Mantém o flavor escolhido no resto do site também aqui. */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('carmilla-flavor') === 'amethyst') {
            document.documentElement.dataset.flavor = 'amethyst';
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main>
      <div class="code">404</div>
      <h1>{ui.pt['notfound.title']}</h1>
      <p>{ui.pt['notfound.lead']}</p>
      <hr />
      <h2>{ui.en['notfound.title']}</h2>
      <p>{ui.en['notfound.lead']}</p>
      <div class="cta">
        <a href="/pt/">{ui.pt['notfound.back']}</a>
        <a href="/en/">{ui.en['notfound.back']}</a>
      </div>
    </main>

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: var(--crypt);
        color: var(--pearl);
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
        text-align: center;
      }
      main {
        max-width: 34rem;
      }
      .code {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: clamp(5rem, 20vw, 10rem);
        line-height: 1;
        background: linear-gradient(180deg, var(--pearl) 0%, var(--carmine) 70%);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }
      h1,
      h2 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-weight: 500;
        font-size: 1.9rem;
        margin-bottom: 0.4rem;
      }
      h2 {
        font-size: 1.5rem;
        color: rgba(var(--pearl-rgb), 0.85);
      }
      p {
        color: var(--ash-mauve);
        line-height: 1.7;
      }
      hr {
        border: none;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(var(--carmine-rgb), 0.4), transparent);
        margin: 2.2rem 0;
      }
      .cta {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2.5rem;
      }
      .cta a {
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.8rem 1.6rem;
        border-radius: 999px;
        color: var(--pearl);
        background: rgba(var(--velvet-rgb), 0.5);
        border: 1px solid rgba(var(--carmine-rgb), 0.4);
        transition: border-color 0.2s, background 0.2s;
      }
      .cta a:hover {
        border-color: var(--carmine);
        background: rgba(var(--velvet-rgb), 0.85);
      }
    </style>
  </body>
</html>
