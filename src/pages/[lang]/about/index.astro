---
import Base from '../../../layouts/Base.astro';
import { langPaths } from '../../../i18n/paths';
import { useTranslations, getLangFromUrl, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Bio e interesses declarados pelo autor.
const bio =
  lang === 'pt'
    ? [
        'Sou <strong>Felipe Lazzarini</strong>, desenvolvedor full stack. Trabalho com software para negócios desde 2020 e sigo estudando como construir sistemas que sejam úteis, claros e fáceis de manter.',
        'Tenho me interessado cada vez mais por engenharia de software e design: como organizar um sistema, justificar escolhas e fazer uma interface que não atrapalhe quem precisa usá-la. Criar temas de editor virou um jeito prático de estudar isso — cada cor, estado e contraste aparece na tela o tempo todo.',
        'Também estou estudando LLMs. Quero entender melhor como funcionam e experimentar aplicações concretas, sem tratar a ferramenta como mágica nem a resposta como certa por padrão. Este site reúne alguns desses estudos; nos repositórios ficam o código e as decisões pelo caminho.',
      ]
    : [
        "I'm <strong>Felipe Lazzarini</strong>, a full stack developer. I've been building software for businesses since 2020, and I keep studying how to make systems useful, clear and easier to maintain.",
        'I’ve grown especially interested in software engineering and design: how to structure a system, explain its choices and make an interface that stays out of the way. Making editor themes became a practical way to study that — every colour, state and contrast is right there on screen.',
        'I’m also studying LLMs. I want to understand how they work and try them on concrete problems, without treating the tool as magic or its answers as automatically correct. This site gathers some of those studies; the repositories show the code and decisions along the way.',
      ];

const stack = {
  frontend: ['TypeScript', 'React', 'Next.js', 'Astro'],
  backend: ['PHP', 'Laravel', 'Node.js', 'WordPress'],
  data: ['MySQL', 'PostgreSQL', 'SQLite'],
  also: ['Python', 'Java', 'C#'],
};

const stackLabels: Record<string, { pt: string; en: string }> = {
  frontend: { pt: 'Frontend', en: 'Frontend' },
  backend: { pt: 'Backend', en: 'Backend' },
  data: { pt: 'Dados', en: 'Data' },
  also: { pt: 'Também', en: 'Also' },
};

const links = [
  { label: 'GitHub', href: 'https://github.com/Muowl', text: 'github.com/Muowl' },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/felipe-lazzarini-4829513b4',
    text: 'felipe-lazzarini',
  },
  {
    label: 'E-mail',
    href: 'mailto:felipe.cunha@archbyte.com.br',
    text: 'felipe.cunha@archbyte.com.br',
  },
  {
    label: 'VS Code Marketplace',
    href: 'https://marketplace.visualstudio.com/publishers/muowl',
    text: 'marketplace/muowl',
  },
];

const openTo = lang === 'pt' ? 'Aberto a oportunidades' : 'Open to opportunities';
---

<Base
  title={`${t('about.title')} — muowl`}
  description={bio[0].replace(/<[^>]+>/g, '')}
>
  <div class="wrap">
    <div class="section-head" style="margin-top:2rem">
      <div class="section-num">❦</div>
      <h1 class="section-title">{t('about.title')}</h1>
    </div>
    <p class="section-subtitle">{t('about.subtitle')}</p>

    <div class="prose">
      {bio.map((para) => <p set:html={para} />)}
      <p class="open-to"><span class="pip" aria-hidden="true"></span>{openTo}</p>
    </div>

    <h2 class="block-title">Stack</h2>
    <div class="stack">
      {
        Object.entries(stack).map(([key, items]) => (
          <div class="stack-row">
            <span class="stack-label">{stackLabels[key][lang]}</span>
            <div class="chips">
              {items.map((i) => (
                <span>{i}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <h2 class="block-title">{t('about.contact')}</h2>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <span class="label">{l.label}</span>
            <a href={l.href}>{l.text}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .prose {
    margin-left: 66px;
    max-width: 68ch;
  }
  .prose p {
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(var(--pearl-rgb), 0.82);
    margin-bottom: 1.2rem;
  }
  .prose :global(strong) {
    color: var(--carmine);
    font-weight: 600;
  }

  .open-to {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem !important;
    color: var(--absinthe) !important;
    border: 1px solid rgba(var(--carmine-rgb), 0.22);
    background: rgba(var(--velvet-rgb), 0.45);
    border-radius: 999px;
    padding: 0.35rem 0.95rem;
    margin-top: 0.4rem;
  }
  .pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--absinthe);
    box-shadow: 0 0 0 3px rgba(122, 224, 166, 0.18);
  }

  .block-title {
    margin: 3.5rem 0 1.2rem 66px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
  }

  .stack {
    margin-left: 66px;
    display: grid;
    gap: 0.9rem;
    max-width: 720px;
  }
  .stack-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .stack-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ash-mauve);
    min-width: 6rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(var(--pearl-rgb), 0.8);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
    border-radius: 999px;
    padding: 0.22rem 0.65rem;
  }

  .links {
    list-style: none;
    margin-left: 66px;
    display: grid;
    gap: 0.7rem;
    max-width: 620px;
  }
  .links li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(var(--carmine-rgb), 0.12);
  }
  .links .label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ash-mauve);
    min-width: 11rem;
  }
  .links a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--carmine);
    text-decoration: none;
    word-break: break-all;
  }
  .links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 680px) {
    .prose,
    .links,
    .stack,
    .block-title {
      margin-left: 0;
    }
    .links li {
      flex-direction: column;
      gap: 0.2rem;
    }
    .stack-label {
      min-width: auto;
    }
  }
</style>
