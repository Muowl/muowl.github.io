---
import Base from '../../../layouts/Base.astro';
import { langPaths } from '../../../i18n/paths';
import { useTranslations, getLangFromUrl, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Bio e interesses declarados pelo autor.
const bio =
  lang === 'pt'
    ? [
        'Sou <strong>Felipe Lazzarini</strong>, desenvolvedor full stack. Trabalho com software para negócios desde 2020, no frontend e no backend.',
        'Nos projetos pessoais, estudo engenharia de software e design de interfaces. Crio temas de editor para trabalhar com paletas, cores de sintaxe e contraste. Vesperveil, Cinder e Carmilla estão reunidos neste site, com links para os repositórios.',
        'Também estou estudando LLMs. Quero entender como funcionam e experimentar seu uso em tarefas de desenvolvimento de software.',
      ]
    : [
        'I’m <strong>Felipe Lazzarini</strong>, a full stack developer. I’ve been building software for businesses since 2020, working on both frontend and backend.',
        'In my personal projects, I study software engineering and interface design. I create editor themes to work with palettes, syntax colours and contrast. This site brings together Vesperveil, Cinder and Carmilla, with links to their repositories.',
        'I’m also studying LLMs. I want to understand how they work and try using them for software development tasks.',
      ];

const stack = {
  frontend: ['TypeScript', 'React', 'Next.js', 'Astro'],
  backend: ['PHP', 'Laravel', 'Node.js', 'WordPress'],
  data: ['MySQL', 'PostgreSQL', 'SQLite'],
  also: ['Python', 'Java', 'C#'],
};

const stackLabels: Record<string, { pt: string; en: string }> = {
  frontend: { pt: 'Frontend', en: 'Frontend' },
  backend: { pt: 'Backend', en: 'Backend' },
  data: { pt: 'Dados', en: 'Data' },
  also: { pt: 'Também', en: 'Also' },
};

const links = [
  { label: 'GitHub', href: 'https://github.com/Muowl', text: 'github.com/Muowl' },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/felipe-lazzarini-4829513b4',
    text: 'felipe-lazzarini',
  },
  {
    label: 'E-mail',
    href: 'mailto:felipe.cunha@archbyte.com.br',
    text: 'felipe.cunha@archbyte.com.br',
  },
  {
    label: 'VS Code Marketplace',
    href: 'https://marketplace.visualstudio.com/publishers/muowl',
    text: 'marketplace/muowl',
  },
];

const openTo = lang === 'pt' ? 'Aberto a oportunidades' : 'Open to opportunities';
---

<Base
  title={`${t('about.title')} — muowl`}
  description={bio[0].replace(/<[^>]+>/g, '')}
>
  <div class="wrap">
    <div class="section-head">
      <h1 class="section-title">{t('about.title')}</h1>
    </div>
    <p class="section-subtitle">{t('about.subtitle')}</p>

    <div class="about-grid">
      <div class="prose">
        {bio.map((para) => <p set:html={para} />)}
        <p class="open-to"><span class="pip" aria-hidden="true"></span>{openTo}</p>
      </div>

      <div class="details">
        <h2 class="block-title">Stack</h2>
        <div class="stack">
          {
            Object.entries(stack).map(([key, items]) => (
              <div class="stack-row">
                <span class="stack-label">{stackLabels[key][lang]}</span>
                <div class="chips">
                  {items.map((i) => <span>{i}</span>)}
                </div>
              </div>
            ))
          }
        </div>

        <h2 class="block-title">{t('about.contact')}</h2>
        <ul class="links">
          {
            links.map((l) => (
              <li>
                <span class="label">{l.label}</span>
                <a href={l.href}>{l.text}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: 2.5rem;
  }
  .details { border-left: var(--border-panel); padding-left: 2rem; }
  .prose {
    max-width: 68ch;
  }
  .prose p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: rgba(var(--pearl-rgb), 0.82);
    margin-bottom: 1.2rem;
  }
  .prose :global(strong) {
    color: var(--carmine);
    font-weight: 600;
  }

  .open-to {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-small) !important;
    color: var(--absinthe) !important;
    border: 1px solid rgba(var(--carmine-rgb), 0.22);
    background: rgba(var(--velvet-rgb), 0.45);
    border-radius: var(--radius-control);
    padding: 0.35rem 0.95rem;
    margin-top: 0.4rem;
  }
  .pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--absinthe);
    box-shadow: 0 0 0 3px rgba(var(--absinthe-rgb), .18);
  }

  .block-title {
    margin: 2.5rem 0 1.2rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
  }
  .block-title:first-child { margin-top: 0; }

  .stack {
    display: grid;
    gap: 0.9rem;
    max-width: 720px;
  }
  .stack-row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: start;
    gap: .75rem;
  }
  .stack-label {
    font-size: var(--text-caption);
    color: var(--ash-mauve);
    padding-top: .25rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips span {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: rgba(var(--pearl-rgb), 0.8);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
    border-radius: var(--radius-control);
    padding: 0.22rem 0.65rem;
  }

  .links {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    max-width: 620px;
  }
  .links li {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: .15rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(var(--carmine-rgb), 0.12);
  }
  .links .label {
    font-size: var(--text-caption);
    color: var(--ash-mauve);
    min-width: 11rem;
  }
  .links a {
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-small);
    color: var(--pearl);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .details { border-left: 0; border-top: var(--border-panel); padding: 2rem 0 0; }
  }
</style>
