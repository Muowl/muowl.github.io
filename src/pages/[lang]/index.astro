---
import Base from '../../layouts/Base.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import { langPaths } from '../../i18n/paths';
import { localePath, useTranslations, getLangFromUrl, type Lang } from '../../i18n/ui';
import { themes } from '../../data/themes';
import { projects } from '../../data/projects';

export const getStaticPaths = langPaths;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'muowl — ' + (lang === 'pt' ? 'temas e ferramentas' : 'themes and tools');
const description = t('home.lead');
---

<Base title={title} description={description}>
  <div class="wrap">
    <header class="hero">
      <div class="eyebrow">{t('home.eyebrow')}</div>
      <h1>muowl</h1>
      <div class="subtitle">{t('home.subtitle')}</div>
      <div class="ornament" aria-hidden="true">❦</div>
      <p class="lead">{t('home.lead')}</p>
      <div class="cta">
        <a class="btn btn-primary" href={localePath(lang, '/themes/')}>
          {t('home.cta.themes')}
        </a>
        <a class="btn btn-ghost" href="https://github.com/Muowl">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
          {t('home.cta.github')}
        </a>
      </div>
    </header>

    <section>
      <div class="section-head">
        <div class="section-num">I.</div>
        <h2 class="section-title">{t('home.themes.title')}</h2>
      </div>
      <p class="section-subtitle">{t('home.themes.subtitle')}</p>

      <div class="card-grid">
        {themes.map((theme) => <ThemeCard theme={theme} lang={lang} />)}
      </div>
    </section>

    <section>
      <div class="section-head">
        <div class="section-num">II.</div>
        <h2 class="section-title">{t('home.projects.title')}</h2>
      </div>
      <p class="section-subtitle">{t('home.projects.subtitle')}</p>

      <div class="card-grid">
        {
          projects.map((p) => (
            <a class="project-card" href={p.url}>
              <div class="top">
                <h3>{p.name}</h3>
                <span class="year">{p.year}</span>
              </div>
              <p>{p.summary[lang]}</p>
              <div class="stack">
                {p.stack.map((s) => (
                  <span>{s}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1rem 4rem;
  }

  .hero .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ash-mauve);
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, var(--pearl) 0%, var(--carmine) 60%, var(--wisteria) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    margin-bottom: 1rem;
    text-shadow: 0 0 80px rgba(var(--carmine-rgb), 0.15);
  }

  .hero .subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: var(--wisteria);
    margin-bottom: 2rem;
    opacity: 0.92;
  }

  .hero .lead {
    font-size: 1.05rem;
    max-width: 580px;
    margin: 0 auto;
    color: rgba(var(--pearl-rgb), 0.78);
    line-height: 1.7;
  }

  .hero .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.2rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--velvet);
    border: 1px solid rgba(var(--carmine-rgb), 0.12);
    border-radius: 1.2rem;
    padding: 1.4rem 1.5rem 1.5rem;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--carmine-rgb), 0.45);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.7);
  }
  .project-card .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .project-card h3 {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--carmine);
  }
  .project-card .year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash-mauve);
  }
  .project-card p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(var(--pearl-rgb), 0.72);
    margin-top: 0.7rem;
  }
  .project-card .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .project-card .stack span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ash-mauve);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
</style>
