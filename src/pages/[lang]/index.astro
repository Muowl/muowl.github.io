---
import Base from '../../layouts/Base.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import CinderEditor from '../../components/CinderEditor.astro';
import Owl from '../../components/Owl.astro';
import { langPaths } from '../../i18n/paths';
import { localePath, useTranslations, getLangFromUrl } from '../../i18n/ui';
import { themes } from '../../data/themes';
import { projects } from '../../data/projects';
export const getStaticPaths = langPaths;
const lang = getLangFromUrl(Astro.url);
const pt = lang === 'pt';
const t = useTranslations(lang);
---
<Base title={pt ? 'muowl — código, cor e cuidado' : 'muowl — code, colour and care'} description={t('home.lead')}>
  <div class="wrap home">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">FELIPE LAZZARINI <span> / </span> {pt ? 'DESENVOLVEDOR & CRIADOR' : 'DEVELOPER & MAKER'}</p>
        <h1>{pt ? 'Código com intenção.' : 'Code with intention.'}<br /><em>{pt ? 'Cor com alma.' : 'Colour with soul.'}</em></h1>
        <p class="intro">{t('home.lead')}</p>
        <div class="hero-links"><a class="btn btn-primary" href="#collection">{pt ? 'Explore os temas' : 'Explore the themes'} <span aria-hidden="true">↘</span></a><a class="text-link" href={localePath(lang, '/about/')}>{pt ? 'Um pouco sobre mim' : 'A little about me'} <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="seal" aria-hidden="true"><span class="seal-top">MUOWL · INDEPENDENT WORK</span><Owl class="hero-owl" /><span class="seal-bottom">CODE / COLOUR / CRAFT</span><span class="orbit"></span></div>
    </header>
    <div class="folio"><span>{pt ? 'UM PEQUENO ESTÚDIO DIGITAL' : 'A SMALL DIGITAL STUDIO'}</span><span>{pt ? 'FEITO NO BRASIL · ABERTO PARA O MUNDO' : 'MADE IN BRAZIL · OPEN TO THE WORLD'}</span></div>
    <section class="featured" aria-labelledby="featured-title">
      <div class="feature-copy"><p class="eyebrow">01 / {pt ? 'EM DESTAQUE' : 'IN THE SPOTLIGHT'}</p><h2 id="featured-title">Cinder<span class="period">.</span></h2><p class="feature-tagline">{pt ? 'O calor de uma boa ideia.' : 'The warmth of a good idea.'}</p><p>{pt ? 'Um tema escuro feito de carvão, brasa e ouro antigo. Cores que organizam o código e deixam espaço para o que você está construindo.' : 'A dark theme made of charcoal, embers and antique gold. Colours that organise your code and leave room for what you’re building.'}</p><div class="feature-meta"><span>VS CODE</span><span>v0.3.0</span><span>OPEN SOURCE</span></div><a class="text-link" href={localePath(lang, '/themes/cinder/')}>{pt ? 'Conheça o Cinder' : 'Meet Cinder'} <span aria-hidden="true">↗</span></a></div>
      <div class="feature-preview"><CinderEditor lang={lang} /></div>
    </section>
    <section id="collection" aria-labelledby="collection-title">
      <div class="collection-head"><div><p class="eyebrow">02 / {pt ? 'A COLEÇÃO' : 'THE COLLECTION'}</p><h2 id="collection-title">{pt ? 'Uma paleta. Um universo.' : 'A palette. A world.'}</h2></div><span class="collection-count">{String(themes.length).padStart(2, '0')} {pt ? 'TEMAS AUTORAIS' : 'ORIGINAL THEMES'}</span></div>
      <div class="card-grid">{themes.map(theme => <ThemeCard theme={theme} lang={lang} />)}</div>
    </section>
    <section class="work" aria-labelledby="work-title">
      <div><p class="eyebrow">03 / {pt ? 'POR DENTRO' : 'UNDER THE SURFACE'}</p><h2 id="work-title">{pt ? 'O cuidado também está no código.' : 'The care is in the code, too.'}</h2><p>{pt ? 'Paletas documentadas, tokens com propósito e ferramentas abertas. Entre, leia, use, transforme.' : 'Documented palettes, purposeful tokens and open tools. Step in, read, use, make it your own.'}</p><a class="text-link" href="https://github.com/Muowl">GitHub <span aria-hidden="true">↗</span></a></div>
      <div class="repo-list">{projects.map((p, i) => <a href={p.url}><span class="repo-number">0{i + 1}</span><div><h3>{p.name}</h3><p>{p.summary[lang]}</p><span class="repo-stack">{p.stack.join(' / ')}</span></div><span aria-hidden="true">↗</span></a>)}</div>
    </section>
    <aside class="closing"><p>{pt ? 'Pequenos detalhes. Muitas horas de uso.' : 'Small details. Many hours of use.'}</p><a class="text-link" href={localePath(lang, '/about/')}>{pt ? 'Vamos conversar' : 'Let’s talk'} ↗</a></aside>
  </div>
</Base>
<style>
  .home { max-width: 1280px; padding-top: 0; }
  .hero { display: grid; grid-template-columns: 1fr 260px; align-items: center; gap: 3rem; padding: 6.5rem 0 5rem; }
  .eyebrow { font: .65rem/1.7 var(--font-mono); letter-spacing: .13em; color: var(--ash-mauve); }
  .eyebrow span { margin: 0 .5rem; }
  h1 { font: 500 clamp(3.2rem, 6.2vw, 5.7rem)/.99 var(--font-display); letter-spacing: -.04em; margin: 2rem 0; }
  h1 em { color: var(--carmine); font-weight: 400; }
  .intro { max-width: 49ch; color: var(--ash-mauve); font-size: .98rem; line-height: 1.8; }
  .hero-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.7rem; margin-top: 2.2rem; }
  .text-link { display: inline-flex; gap: 1.3rem; align-items: center; text-decoration: none; font-size: .84rem; border-bottom: 1px solid var(--carmine); padding-bottom: .35rem; }
  .text-link:hover { color: var(--carmine); }
  .seal { position: relative; width: 250px; height: 250px; border: 1px solid rgba(var(--carmine-rgb), .3); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: var(--carmine); transform: rotate(9deg); }
  .seal :global(.hero-owl) { width: 125px; height: 125px; stroke-width: 1; }
  .seal-top, .seal-bottom { font: .51rem var(--font-mono); letter-spacing: .15em; }
  .orbit { position: absolute; inset: -14px; border: 1px dashed rgba(var(--carmine-rgb), .22); border-radius: 50%; }
  .folio { display: flex; justify-content: space-between; gap: 1rem; border-block: 1px solid rgba(var(--pearl-rgb), .2); padding: 1rem 0; font: .59rem/1.6 var(--font-mono); letter-spacing: .12em; color: var(--ash-mauve); }
  .featured { display: grid; grid-template-columns: .85fr 1.15fr; gap: 5rem; align-items: center; margin-top: 4.5rem; }
  .feature-copy h2 { font: 500 clamp(4rem, 7vw, 6.8rem)/1 var(--font-display); letter-spacing: -.045em; margin-top: 1.3rem; }
  .period { color: var(--carmine); }
  .feature-tagline { font: italic 1.55rem var(--font-display); margin: .6rem 0 1.4rem; }
  .feature-copy > p:not([class]), .work > div > p:not([class]) { color: var(--ash-mauve); font-size: .9rem; line-height: 1.8; }
  .feature-meta { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.8rem 0; font: .6rem var(--font-mono); color: var(--ash-mauve); }
  .feature-preview { min-width: 0; padding: 1.5rem; background: var(--velvet); border-radius: 10px; }
  .collection-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; }
  .collection-head h2, .work h2 { font: 500 clamp(2.3rem, 4vw, 3.5rem)/1.08 var(--font-display); letter-spacing: -.025em; margin-top: .9rem; }
  .collection-count { font: .6rem var(--font-mono); color: var(--ash-mauve); white-space: nowrap; padding-bottom: .4rem; }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  .work { border-top: 1px solid rgba(var(--pearl-rgb), .2); padding-top: 3rem; display: grid; grid-template-columns: .8fr 1.2fr; gap: 5rem; }
  .work > div > p:not([class]) { margin: 1.5rem 0; }
  .repo-list a { display: grid; grid-template-columns: 1.5rem 1fr 1rem; gap: 1rem; text-decoration: none; padding: 1.5rem 0; border-bottom: 1px solid rgba(var(--pearl-rgb), .18); }
  .repo-list a:first-child { padding-top: 0; }
  .repo-list a:hover h3 { color: var(--carmine); text-decoration: underline; }
  .repo-number, .repo-stack { font: .6rem var(--font-mono); color: var(--ash-mauve); }
  .repo-number { padding-top: .5rem; }
  .repo-list h3 { font: 500 1.1rem var(--font-mono); }
  .repo-list p { font-size: .8rem; color: var(--ash-mauve); margin: .6rem 0; }
  .closing { margin-top: 6rem; padding: 2.5rem 0 0; border-top: 1px solid rgba(var(--pearl-rgb), .2); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .closing p { font: italic clamp(1.5rem, 3vw, 2.4rem) var(--font-display); }
  @media(max-width: 950px) { .hero { grid-template-columns: 1fr 180px; gap: 1.5rem; } .seal { width: 170px; height: 170px; } .seal :global(.hero-owl) { width: 80px; height: 80px; } .seal-top, .seal-bottom { font-size: .38rem; } .featured, .work { gap: 2rem; } .card-grid { grid-template-columns: 1fr; } }
  @media(max-width: 680px) { .hero { display: block; padding: 3.5rem 0; } .seal { display: none; } .hero-links { gap: 1.2rem; } .folio { flex-direction: column; gap: .3rem; } .featured, .work { grid-template-columns: 1fr; } .feature-preview { padding: .65rem; } .collection-head, .closing { flex-direction: column; align-items: start; } .closing { margin-top: 4rem; } }
</style>
