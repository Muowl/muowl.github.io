---
import Base from '../../layouts/Base.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import Owl from '../../components/Owl.astro';
import { langPaths } from '../../i18n/paths';
import { localePath, useTranslations, getLangFromUrl } from '../../i18n/ui';
import { themes } from '../../data/themes';
import { projects } from '../../data/projects';
export const getStaticPaths = langPaths;
const lang = getLangFromUrl(Astro.url);
const pt = lang === 'pt';
const t = useTranslations(lang);
---
<Base title={pt ? 'muowl — software, design e aprendizado' : 'muowl — software, design and learning'} description={t('home.lead')}>
  <div class="wrap home">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">FELIPE LAZZARINI <span> / </span> {pt ? 'DESENVOLVEDOR & CRIADOR' : 'DEVELOPER & MAKER'}</p>
        <h1>{pt ? 'Aprender fazendo.' : 'Learning by building.'}<br /><em>{pt ? 'Pensar em cada detalhe.' : 'Thinking through the details.'}</em></h1>
        <p class="intro">{t('home.lead')}</p>
        <div class="hero-links"><a class="btn btn-primary" href="#collection">{pt ? 'Ver o que estou fazendo' : 'See what I’m working on'} <span aria-hidden="true">↘</span></a><a class="text-link" href={localePath(lang, '/about/')}>{pt ? 'Como penso e o que estudo' : 'How I think and what I study'} <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="seal" aria-hidden="true"><span class="seal-top">REC ●  /  MUOWL 01</span><Owl class="hero-owl" /><span class="seal-bottom">PLAY ▸  /  CODE + COLOUR</span><span class="orbit"></span></div>
    </header>
    <div class="folio"><span>{pt ? 'ESTUDOS EM ANDAMENTO, CÓDIGO ABERTO' : 'ONGOING STUDIES, OPEN SOURCE CODE'}</span><span>{pt ? 'FEITO NO BRASIL · ABERTO PARA O MUNDO' : 'MADE IN BRAZIL · OPEN TO THE WORLD'}</span></div>
    <section class="featured" aria-labelledby="featured-title">
      <div class="feature-copy"><p class="eyebrow">01 / {pt ? 'EM DESTAQUE' : 'FEATURED'}</p><h2 id="featured-title">Vesperveil<span class="period">.</span></h2><p class="feature-tagline">{pt ? 'Vinho, marfim e um véu de carmim.' : 'Wine, ivory and a veil of carmine.'}</p><p>{pt ? 'Fiz este tema para passar o dia no editor sem cansar os olhos. Testei os tons em TypeScript e Python; o contraste segura a leitura, e as cores de sintaxe ajudam a separar o que estou vendo.' : 'I made this theme for long days in the editor. I tried the colours in TypeScript and Python; contrast keeps the text readable, while syntax colours help separate what I’m looking at.'}</p><div class="feature-meta"><span>VS CODE</span><span>v0.1.0</span><span>OPEN SOURCE</span></div><a class="text-link" href={localePath(lang, '/themes/vesperveil/')}>{pt ? 'Ver como o tema funciona' : 'See how the theme works'} <span aria-hidden="true">↗</span></a></div>
      <div class="feature-preview"><div class="tape-heading"><span>MUOWL / VESPERVEIL</span><span>SP ▸ 01:22:06</span></div><img src="/themes/vesperveil/vesperveil-typescript.png" width="1600" height="900" alt={pt ? 'Captura do Vesperveil no VS Code com código TypeScript' : 'Vesperveil in VS Code with TypeScript code'} loading="lazy" /><span class="tape-foot">{pt ? 'CAPTURA REAL · VS CODE' : 'ACTUAL SCREENSHOT · VS CODE'}</span></div>
    </section>
    <section id="collection" aria-labelledby="collection-title">
      <div class="collection-head"><div><p class="eyebrow">02 / {pt ? 'ESTUDOS DE COR' : 'COLOUR STUDIES'}</p><h2 id="collection-title">{pt ? 'Temas que estou desenvolvendo.' : 'Themes I’m working on.'}</h2></div><span class="collection-count">{String(themes.length).padStart(2, '0')} {pt ? 'TEMAS' : 'THEMES'}</span></div>
      <div class="card-grid">{themes.map(theme => <ThemeCard theme={theme} lang={lang} />)}</div>
    </section>
    <section class="work" aria-labelledby="work-title">
      <div><p class="eyebrow">03 / {pt ? 'CADERNO ABERTO' : 'OPEN NOTEBOOK'}</p><h2 id="work-title">{pt ? 'Estudo melhor quando posso testar.' : 'I learn best when I can test an idea.'}</h2><p>{pt ? 'Cada repositório guarda decisões, tentativas e o resultado até aqui. Estou estudando engenharia de software, design de interfaces e LLMs; esse trabalho é parte do processo.' : 'Each repository keeps the decisions, experiments and the result so far. I’m studying software engineering, interface design and LLMs; this work is part of that process.'}</p><a class="text-link" href="https://github.com/Muowl">GitHub <span aria-hidden="true">↗</span></a></div>
      <div class="repo-list">{projects.map((p, i) => <a href={p.url}><span class="repo-number">0{i + 1}</span><div><h3>{p.name}</h3><p>{p.summary[lang]}</p><span class="repo-stack">{p.stack.join(' / ')}</span></div><span aria-hidden="true">↗</span></a>)}</div>
    </section>
    <aside class="closing"><p>{pt ? 'Aprendiz para a vida toda. Curioso por natureza.' : 'A lifelong learner. Curious by nature.'}</p><a class="text-link" href={localePath(lang, '/about/')}>{pt ? 'Mais sobre meu percurso' : 'More about my work'} ↗</a></aside>
  </div>
</Base>
<style>
  .home { max-width: 1280px; padding-top: 0; }
  .hero { display: grid; grid-template-columns: 1fr 260px; align-items: center; gap: 3rem; padding: 6.5rem 0 5rem; }
  .eyebrow { font: .65rem/1.7 var(--font-mono); letter-spacing: .13em; color: var(--ash-mauve); }
  .eyebrow span { margin: 0 .5rem; }
  h1 { font: 500 clamp(3.2rem, 6.2vw, 5.7rem)/.99 var(--font-display); letter-spacing: -.04em; margin: 2rem 0; }
  h1 em { color: var(--champagne); font-weight: 400; text-shadow: -1px 0 rgba(var(--wisteria-rgb), .55), 1px 0 rgba(var(--carmine-rgb), .6); }
  .intro { max-width: 49ch; color: var(--ash-mauve); font-size: .98rem; line-height: 1.8; }
  .hero-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.7rem; margin-top: 2.2rem; }
  .text-link { display: inline-flex; gap: 1.3rem; align-items: center; text-decoration: none; font-size: .84rem; border-bottom: 1px solid var(--carmine); padding-bottom: .35rem; }
  .text-link:hover { color: var(--carmine); }
  .seal { position: relative; width: 250px; height: 250px; border: 1px solid rgba(var(--carmine-rgb), .4); border-radius: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: var(--champagne); }
  .seal :global(.hero-owl) { width: 125px; height: 125px; stroke-width: 1; }
  .seal-top, .seal-bottom { font: .51rem var(--font-mono); letter-spacing: .15em; }
  .orbit { position: absolute; inset: 9px; border: 1px solid rgba(var(--carmine-rgb), .2); pointer-events: none; }
  .folio { display: flex; justify-content: space-between; gap: 1rem; border-block: 1px solid rgba(var(--pearl-rgb), .2); padding: 1rem 0; font: .59rem/1.6 var(--font-mono); letter-spacing: .12em; color: var(--ash-mauve); }
  .featured { display: grid; grid-template-columns: .85fr 1.15fr; gap: 5rem; align-items: center; margin-top: 4.5rem; }
  .feature-copy h2 { font: 500 clamp(3.2rem, 5vw, 5rem)/1 var(--font-display); letter-spacing: -.045em; margin-top: 1.3rem; }
  .period { color: var(--carmine); }
  .feature-tagline { font: italic 1.55rem var(--font-display); margin: .6rem 0 1.4rem; }
  .feature-copy > p:not([class]), .work > div > p:not([class]) { color: var(--ash-mauve); font-size: .9rem; line-height: 1.8; }
  .feature-meta { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.8rem 0; font: .6rem var(--font-mono); color: var(--ash-mauve); }
  .feature-preview { min-width: 0; padding: 1rem; background: var(--velvet); border: 1px solid var(--selection); border-radius: 3px; box-shadow: -2px 0 rgba(var(--wisteria-rgb), .35), 2px 0 rgba(var(--carmine-rgb), .45); }
  .feature-preview img { display: block; width: 100%; height: auto; border: 1px solid var(--selection); }
  .tape-heading, .tape-foot { display: flex; justify-content: space-between; gap: 1rem; color: var(--champagne); font: .6rem/1.5 var(--font-mono); letter-spacing: .08em; }
  .tape-heading { padding: .1rem .1rem .8rem; }
  .tape-foot { display: block; padding: .8rem .1rem .1rem; color: var(--ash-mauve); }
  .collection-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; }
  .collection-head h2, .work h2 { font: 500 clamp(2.3rem, 4vw, 3.5rem)/1.08 var(--font-display); letter-spacing: -.025em; margin-top: .9rem; }
  .collection-count { font: .6rem var(--font-mono); color: var(--ash-mauve); white-space: nowrap; padding-bottom: .4rem; }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  .work { border-top: 1px solid rgba(var(--pearl-rgb), .2); padding-top: 3rem; display: grid; grid-template-columns: .8fr 1.2fr; gap: 5rem; }
  .work > div > p:not([class]) { margin: 1.5rem 0; }
  .repo-list a { display: grid; grid-template-columns: 1.5rem 1fr 1rem; gap: 1rem; text-decoration: none; padding: 1.5rem 0; border-bottom: 1px solid rgba(var(--pearl-rgb), .18); }
  .repo-list a:first-child { padding-top: 0; }
  .repo-list a:hover h3 { color: var(--carmine); text-decoration: underline; }
  .repo-number, .repo-stack { font: .6rem var(--font-mono); color: var(--ash-mauve); }
  .repo-number { padding-top: .5rem; }
  .repo-list h3 { font: 500 1.1rem var(--font-mono); }
  .repo-list p { font-size: .8rem; color: var(--ash-mauve); margin: .6rem 0; }
  .closing { margin-top: 6rem; padding: 2.5rem 0 0; border-top: 1px solid rgba(var(--pearl-rgb), .2); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .closing p { font: italic clamp(1.5rem, 3vw, 2.4rem) var(--font-display); }
  @media(max-width: 950px) { .hero { grid-template-columns: 1fr 180px; gap: 1.5rem; } .seal { width: 170px; height: 170px; } .seal :global(.hero-owl) { width: 80px; height: 80px; } .seal-top, .seal-bottom { font-size: .38rem; } .featured, .work { gap: 2rem; } .card-grid { grid-template-columns: 1fr; } }
  @media(max-width: 680px) { .hero { display: block; padding: 3.5rem 0; } .seal { display: none; } .hero-links { gap: 1.2rem; } .folio { flex-direction: column; gap: .3rem; } .featured, .work { grid-template-columns: 1fr; } .feature-preview { padding: .65rem; } .collection-head, .closing { flex-direction: column; align-items: start; } .closing { margin-top: 4rem; } }
</style>
