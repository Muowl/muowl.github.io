---
import Base from '../../layouts/Base.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import Owl from '../../components/Owl.astro';
import { langPaths } from '../../i18n/paths';
import { localePath, useTranslations, getLangFromUrl } from '../../i18n/ui';
import { listedThemes } from '../../data/themes';
import { listedProjects } from '../../data/projects';
export const getStaticPaths = langPaths;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const featuredTheme = listedThemes.find((theme) => theme.slug === 'vesperveil')!;
---
<Base title={t('home.title')} description={t('home.lead')}>
  <div class="wrap home">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow hero-label"><span>FELIPE LAZZARINI</span><span class="divider" aria-hidden="true">/</span><span>{t('home.role')}</span></p>
        <h1>{t('home.headline')}<br /><em>{t('home.headline.themes')}</em></h1>
        <p class="intro">{t('home.lead')}</p>
        <div class="hero-links"><a class="btn btn-primary" href="#collection">{t('home.cta.themes')} <span aria-hidden="true">↘</span></a><a class="text-link" href={localePath(lang, '/about/')}>{t('home.cta.about')} <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="seal" aria-hidden="true"><span class="seal-top">REC ●  /  MUOWL 01</span><Owl class="hero-owl" /><span class="seal-bottom">PLAY ▸  /  CODE + COLOUR</span><span class="orbit"></span></div>
    </header>
    <div class="folio"><span>{t('home.folio.work')}</span><span>{t('home.folio.location')}</span></div>
    <section class="featured" aria-labelledby="featured-title">
      <div class="feature-copy"><p class="eyebrow">01 / {t('home.featured.title')}</p><h2 id="featured-title">{featuredTheme.name}<span class="period">.</span></h2><p class="feature-tagline">{featuredTheme.tagline[lang]}</p><p>{t('home.featured.lead')}</p><div class="feature-meta"><span>VS CODE</span><span>v{featuredTheme.version}</span><span>OPEN SOURCE</span></div><a class="text-link" href={localePath(lang, '/themes/vesperveil/')}>{t('home.featured.link')} <span aria-hidden="true">↗</span></a></div>
      <figure class="feature-preview"><div class="tape-heading"><span>MUOWL / VESPERVEIL</span><span aria-hidden="true">SP ▸ 01:22:06</span></div><a class="preview-link" href="/themes/vesperveil/vesperveil-typescript.png" aria-label={`${t('screenshot.open')} — Vesperveil / TypeScript`}><img src="/themes/vesperveil/vesperveil-typescript.png" width="1600" height="900" alt={t('home.featured.alt')} loading="lazy" /><span class="tape-foot"><span>{t('home.featured.caption')}</span><span class="preview-action">{t('screenshot.open')} <span aria-hidden="true">↗</span></span></span></a></figure>
    </section>
    <section id="collection" aria-labelledby="collection-title">
      <div class="collection-head"><div><p class="eyebrow">02 / {t('home.themes.subtitle')}</p><h2 id="collection-title">{t('home.themes.title')}</h2></div><div class="collection-meta"><span class="collection-count">{String(listedThemes.length).padStart(2, '0')} {t('themes.title')}</span><a class="text-link" href={localePath(lang, '/themes/')}>{t('home.all.themes')} <span aria-hidden="true">↗</span></a></div></div>
      <div class="card-grid">{listedThemes.map(theme => <ThemeCard theme={theme} lang={lang} />)}</div>
    </section>
    <section class="work" aria-labelledby="work-title">
      <div><p class="eyebrow">03 / {t('home.projects.title')}</p><h2 id="work-title">{t('home.projects.subtitle')}</h2><p>{t('home.projects.lead')}</p><div class="work-links"><a class="text-link" href={localePath(lang, '/projects/')}>{t('home.all.projects')} <span aria-hidden="true">↗</span></a><a class="text-link" href="https://github.com/Muowl">GitHub <span aria-hidden="true">↗</span></a></div></div>
      <div class="repo-list">{listedProjects.map((p, i) => <a href={p.url}><span class="repo-number">0{i + 1}</span><div><h3>{p.name}</h3><p>{p.summary[lang]}</p><span class="repo-stack">{p.stack.join(' / ')}</span></div><span aria-hidden="true">↗</span></a>)}</div>
    </section>
  </div>
</Base>
<style>
  .home { padding-top: 0; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(4rem, 7vw, 6rem) 0 clamp(3rem, 5vw, 4.5rem);
  }
  .eyebrow { font: 500 var(--text-caption)/1.7 var(--font-mono); letter-spacing: .06em; color: var(--champagne); }
  .eyebrow span { margin-inline: .4rem; }
  .hero-label { display: flex; align-items: baseline; flex-wrap: wrap; gap: .25rem .75rem; }
  .hero-label span { margin: 0; }
  h1 { font: 500 clamp(3.5rem, 6.3vw, 6rem)/1.04 var(--font-display); letter-spacing: -.035em; margin: 1.5rem 0; }
  h1 em { color: var(--champagne); font-weight: 400; }
  .intro { max-width: 54ch; color: rgba(var(--pearl-rgb), .84); font-size: 1.0625rem; line-height: 1.8; }
  .hero-links, .work-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .hero-links { margin-top: 2rem; }
  .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    min-height: 44px;
    text-decoration: none;
    font: 500 var(--text-caption)/1.5 var(--font-mono);
    border-bottom: 1px solid rgba(var(--carmine-rgb), .6);
    transition: color .2s, border-color .2s;
  }
  .text-link:hover { color: var(--champagne); border-color: var(--champagne); }
  .seal {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    border: var(--border-panel);
    border-radius: var(--radius-panel);
    background: linear-gradient(135deg, rgba(var(--velvet-rgb), .8), transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    color: var(--champagne);
    box-shadow: -1px 0 rgba(var(--wisteria-rgb), .15), 1px 0 rgba(var(--carmine-rgb), .2);
  }
  .seal :global(.hero-owl) { width: 120px; height: 120px; }
  .seal-top, .seal-bottom { font: .6875rem/1.5 var(--font-mono); letter-spacing: .06em; }
  .orbit { position: absolute; inset: 10px; border: 1px dashed rgba(var(--carmine-rgb), .25); pointer-events: none; }
  .folio { display: flex; justify-content: space-between; gap: 1rem; border-block: var(--border-panel); padding: 1rem 0; font: var(--text-caption)/1.6 var(--font-mono); color: var(--ash-mauve); }
  .featured { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; margin-top: 4rem; }
  .feature-copy h2 { font: 500 clamp(3.5rem, 5vw, 5rem)/1.05 var(--font-display); letter-spacing: -.035em; margin-top: 1rem; }
  .period { color: var(--carmine); }
  .feature-tagline { font: italic 1.65rem/1.3 var(--font-display); color: var(--champagne); margin: .65rem 0 1.25rem; }
  .feature-copy > p:not([class]), .work > div > p:not([class]) { color: rgba(var(--pearl-rgb), .84); font-size: 1rem; line-height: 1.8; }
  .feature-meta { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 1rem; font: var(--text-caption)/1.5 var(--font-mono); color: var(--ash-mauve); }
  .feature-meta span { border: var(--border-panel); border-radius: var(--radius-control); padding: .35rem .6rem; }
  .feature-preview { margin: 0; min-width: 0; padding: .85rem; background: var(--velvet); border: var(--border-panel); border-radius: var(--radius-panel); }
  .preview-link { display: block; text-decoration: none; border-radius: var(--radius-control); }
  .feature-preview img { display: block; width: 100%; height: auto; border: var(--border-panel); }
  .tape-heading { display: flex; justify-content: space-between; gap: 1rem; padding: .1rem .1rem .85rem; color: var(--champagne); font: var(--text-caption)/1.5 var(--font-mono); }
  .tape-heading > :last-child { font-size: .6875rem; color: var(--ash-mauve); white-space: nowrap; }
  .tape-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem 1rem; min-height: 48px; padding: .8rem .1rem .1rem; color: var(--ash-mauve); font: var(--text-caption)/1.5 var(--font-mono); }
  .preview-action { color: var(--pearl); }
  .preview-link:hover .preview-action { color: var(--champagne); text-decoration: underline; text-underline-offset: .3rem; }
  .collection-head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.75rem; }
  .collection-head h2, .work h2 { font: 500 clamp(2.75rem, 4vw, 3.75rem)/1.1 var(--font-display); letter-spacing: -.025em; margin-top: .6rem; }
  .collection-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .collection-count { font: var(--text-caption)/1.5 var(--font-mono); color: var(--ash-mauve); white-space: nowrap; }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .work { border-top: var(--border-panel); padding-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); }
  .work > div > p:not([class]) { margin: 1.25rem 0; }
  .repo-list a { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr) 1rem; gap: .75rem; text-decoration: none; padding: 1.5rem .5rem; border-bottom: var(--border-panel); transition: background .2s, border-color .2s; }
  .repo-list a:first-child { padding-top: .5rem; }
  .repo-list a:hover { background: rgba(var(--velvet-rgb), .45); border-bottom-color: var(--carmine); }
  .repo-list a:hover h3 { color: var(--champagne); }
  .repo-list a > :last-child { color: var(--champagne); }
  .repo-number, .repo-stack { font: var(--text-caption)/1.6 var(--font-mono); color: var(--ash-mauve); }
  .repo-number { padding-top: .25rem; }
  .repo-list h3 { font: 500 1.125rem/1.5 var(--font-mono); }
  .repo-list p { font-size: var(--text-small); line-height: 1.75; color: rgba(var(--pearl-rgb), .84); margin: .5rem 0 .75rem; }
  @media (max-width: 980px) {
    .hero { grid-template-columns: minmax(0, 1fr) 200px; gap: 2rem; }
    .seal :global(.hero-owl) { width: 96px; height: 96px; }
    .seal-top, .seal-bottom { font-size: .5625rem; }
    .featured, .work { grid-template-columns: 1fr; }
    .feature-copy > p:not([class]), .work > div > p:not([class]) { max-width: 65ch; }
    .card-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-block: 3.5rem 2.75rem; }
    .seal { display: none; }
    .hero-label { flex-direction: column; gap: .2rem; }
    .hero-label .divider { display: none; }
    h1 { font-size: clamp(3.25rem, 9vw, 4.5rem); }
    .featured { margin-top: 3rem; }
    .folio { flex-wrap: wrap; gap: .5rem; }
    .collection-head { align-items: start; flex-direction: column; gap: .75rem; }
    .collection-meta { justify-content: space-between; width: 100%; }
    .feature-preview { padding: .65rem; }
  }
  @media (max-width: 400px) {
    .eyebrow { font-size: .75rem; }
    .tape-heading > :last-child { display: none; }
    .repo-list a { grid-template-columns: 1.5rem minmax(0, 1fr) .75rem; padding-inline: 0; }
  }
</style>
