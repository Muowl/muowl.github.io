---
import Base from '../../layouts/Base.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import ThemeComparator from '../../components/ThemeComparator.astro';
import { langPaths } from '../../i18n/paths';
import { localePath, useTranslations, getLangFromUrl } from '../../i18n/ui';
import { listedThemes } from '../../data/themes';
import { listedProjects } from '../../data/projects';
export const getStaticPaths = langPaths;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const featuredTheme = listedThemes.find(theme => theme.slug === 'vesperveil')!;
---
<Base title={t('home.title')} description={t('home.lead')}>
  <div class="wrap home">
    <header class="hero">
      <div class="hero-copy">
        <p class="hero-label">Felipe Lazzarini <span>{t('home.role')}</span></p>
        <h1>{t('home.headline')}<br />{t('home.headline.themes')}</h1>
        <p class="intro">{t('home.lead')}</p>
        <div class="hero-links"><a class="btn btn-primary" href="#collection">{t('home.cta.themes')}</a><a class="text-link" href="mailto:felipe.cunha@archbyte.com.br">{t('contact.cta')}</a></div>
      </div>
      <ThemeComparator lang={lang} id="home-theme" />
    </header>

    <section class="featured" aria-labelledby="featured-title">
      <div class="feature-copy">
        <p class="section-label">{t('home.featured.title')}</p>
        <h2 id="featured-title">{featuredTheme.name}</h2>
        <p class="feature-tagline">{featuredTheme.tagline[lang]}</p>
        <p>{t('home.featured.lead')}</p>
        <a class="text-link" href={localePath(lang, '/themes/vesperveil/')}>{t('home.featured.link')}</a>
      </div>
      <figure class="feature-preview">
        <a class="preview-link" href="/themes/vesperveil/vesperveil-typescript.png" aria-label={`${t('screenshot.open')} — Vesperveil / TypeScript`}>
          <img src="/themes/vesperveil/vesperveil-typescript.png" width="1600" height="900" alt={t('home.featured.alt')} loading="lazy" />
        </a>
        <figcaption><span>{t('home.featured.caption')} · TypeScript</span><a href="/themes/vesperveil/vesperveil-typescript.png">{t('screenshot.open')}</a></figcaption>
      </figure>
    </section>

    <section id="collection" aria-labelledby="collection-title">
      <div class="collection-head"><div><h2 id="collection-title">{t('home.themes.title')}</h2><p>{t('home.themes.subtitle')}</p></div><a class="text-link" href={localePath(lang, '/themes/')}>{t('home.all.themes')}</a></div>
      <div class="card-grid">{listedThemes.map(theme => <ThemeCard theme={theme} lang={lang} />)}</div>
    </section>

    <section class="work" aria-labelledby="work-title">
      <div><h2 id="work-title">{t('home.projects.subtitle')}</h2><p>{t('home.projects.lead')}</p><div class="work-links"><a class="text-link" href={localePath(lang, '/projects/')}>{t('home.all.projects')}</a><a class="text-link" href="https://github.com/Muowl">GitHub</a></div></div>
      <div class="repo-list">{listedProjects.map(p => <a href={localePath(lang, '/projects/') + `#${p.name}`}><div><h3>{p.name}</h3><p>{p.summary[lang]}</p><span class="repo-stack">{p.stack.join(' / ')}</span></div><span class="repo-action">{t('projects.details')}</span></a>)}</div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <div><h2 id="contact-title">{t('contact.title')}</h2><p>{t('contact.lead')}</p></div>
      <div class="contact-links"><a class="btn btn-primary" href="mailto:felipe.cunha@archbyte.com.br">{t('contact.cta')}</a><a class="text-link" href={localePath(lang, '/about/')}>{t('home.cta.about')}</a></div>
    </section>
  </div>
</Base>
<style>
  .home { padding-top: 0; }
  .hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); align-items: center; gap: clamp(2rem, 4vw, 4rem); padding: clamp(3rem, 6vw, 5rem) 0; }
  .hero-label { color: var(--champagne); font-size: var(--text-small); line-height: 1.7; }
  .hero-label span { display: block; color: var(--ash-mauve); }
  h1 { font: 500 clamp(3rem, 4.7vw, 4.5rem)/1.06 var(--font-display); letter-spacing: -.035em; margin: 1.25rem 0; }
  .intro { max-width: 46ch; color: rgba(var(--pearl-rgb), .84); font-size: 1.0625rem; line-height: 1.8; }
  .hero-links, .work-links, .contact-links { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .hero-links { margin-top: 1.5rem; }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-size: var(--text-small); border-bottom: 1px solid var(--carmine); transition: color .2s, border-color .2s; }
  .text-link:hover { color: var(--champagne); border-color: var(--champagne); }
  .section-label { color: var(--champagne); font-size: var(--text-small); }
  .featured { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; margin-top: 0; padding-top: clamp(2.5rem, 5vw, 4rem); border-top: var(--border-panel); }
  h2 { font: 500 clamp(2.75rem, 4vw, 3.75rem)/1.1 var(--font-display); letter-spacing: -.025em; }
  .feature-copy h2 { margin-top: .65rem; }
  .feature-tagline { font: italic 1.5rem/1.4 var(--font-display); color: var(--champagne); margin: .65rem 0 1.25rem; }
  .feature-copy > p:not([class]), .work > div > p, .contact p { color: rgba(var(--pearl-rgb), .84); font-size: 1rem; line-height: 1.8; }
  .feature-copy .text-link { margin-top: 1rem; }
  .feature-preview { margin: 0; min-width: 0; }
  .preview-link { display: block; border-radius: var(--radius-panel); }
  .feature-preview img { display: block; width: 100%; height: auto; border: var(--border-panel); border-radius: var(--radius-panel); }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .25rem 1rem; padding-top: .5rem; color: var(--ash-mauve); font-size: var(--text-caption); }
  figcaption a { display: inline-flex; align-items: center; min-height: 44px; color: var(--pearl); text-underline-offset: .3em; }
  figcaption a:hover { color: var(--champagne); }
  .collection-head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .collection-head p { margin-top: .65rem; color: var(--ash-mauve); }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .work { border-top: var(--border-panel); padding-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); }
  .work > div > p { margin: 1.25rem 0; max-width: 55ch; }
  .repo-list a { display: block; text-decoration: none; padding: 1.5rem 0; border-bottom: var(--border-panel); }
  .repo-list a:first-child { padding-top: 0; }
  .repo-list a:hover h3, .repo-list a:hover .repo-action { color: var(--champagne); }
  .repo-stack { font: .75rem/1.6 var(--font-mono); color: var(--ash-mauve); }
  .repo-list h3 { font: 500 1.125rem/1.5 var(--font-mono); }
  .repo-list p { font-size: var(--text-small); line-height: 1.75; color: rgba(var(--pearl-rgb), .84); margin: .5rem 0 .75rem; }
  .repo-action { display: inline-block; margin-top: .65rem; font-size: var(--text-caption); text-decoration: underline; text-underline-offset: .3em; }
  .contact { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem 3rem; padding-top: clamp(2.5rem, 5vw, 4rem); border-top: var(--border-panel); }
  .contact h2 { font-size: clamp(2.5rem, 4vw, 3rem); }
  .contact p { margin-top: .8rem; max-width: 52ch; }
  @media (max-width: 980px) {
    .hero, .featured, .work { grid-template-columns: 1fr; }
    .hero { gap: 2rem; }
    .hero-copy { max-width: 65ch; }
    .card-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero { padding-block: 2rem 2.5rem; }
    h1 { font-size: clamp(2.75rem, 9vw, 4rem); margin-block: 1rem; }
    .intro { font-size: 1rem; line-height: 1.7; }
    .collection-head { align-items: start; flex-direction: column; gap: .75rem; }
  }
</style>
