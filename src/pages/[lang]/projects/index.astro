---
import Base from '../../../layouts/Base.astro';
import { langPaths } from '../../../i18n/paths';
import { useTranslations, getLangFromUrl, type Lang } from '../../../i18n/ui';
import { listedProjects } from '../../../data/projects';

export const getStaticPaths = langPaths;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ordered = [...listedProjects].sort((a, b) => b.year - a.year);
---

<Base title={`${t('projects.title')} — muowl`} description={t('projects.lead')}>
  <div class="wrap">
    <div class="section-head">
      <h1 class="section-title">{t('projects.title')}</h1>
    </div>
    <p class="section-subtitle">{t('projects.subtitle')}</p>
    <p class="lead-text">{t('projects.lead')}</p>

    <ul class="project-list">
      {
        ordered.map((p) => (
          <li>
            <a href={p.url}>
              <div class="row">
                <h2>{p.name}</h2>
                <span class="year">{p.year}</span>
              </div>
              <p>{p.summary[lang]}</p>
              <div class="stack">
                {p.stack.map((s) => (
                  <span>{s}</span>
                ))}
              </div>
              <span class="project-action">{t('projects.visit')} <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .project-list {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
    max-width: 960px;
  }

  .project-list a {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--velvet);
    border: var(--border-panel);
    border-radius: var(--radius-panel);
    padding: clamp(1.25rem, 3vw, 2rem);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .project-list a:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--carmine-rgb), 0.45);
    box-shadow: 0 12px 28px -20px rgba(var(--crypt-rgb), .8);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--pearl);
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ash-mauve);
  }

  p {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(var(--pearl-rgb), .84);
    margin-top: 0.6rem;
    max-width: 70ch;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .stack span {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--ash-mauve);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
    border-radius: var(--radius-control);
    padding: 0.2rem 0.6rem;
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    margin-top: 1rem;
    font: 500 var(--text-caption)/1.5 var(--font-mono);
    color: var(--champagne);
  }
</style>
