---
import Base from '../../../layouts/Base.astro';
import ThemeInstallation from '../../../components/ThemeInstallation.astro';
import CarmillaShowcase from '../../../components/CarmillaShowcase.astro';
import CarmillaFlavorSwitch from '../../../components/CarmillaFlavorSwitch.astro';
import PapilioShowcase from '../../../components/PapilioShowcase.astro';
import CinderShowcase from '../../../components/CinderShowcase.astro';
import VesperveilShowcase from '../../../components/VesperveilShowcase.astro';
import { vesperveil, vesperveilSiteCss } from '../../../lib/vesperveil';
import { cinder, cinderSiteCss } from '../../../lib/cinder';
import {
  siteVarsCss as papilioSiteVars,
  BG as papilioBg,
  flavors as papilioFlavors,
} from '../../../lib/papilio';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { languages, localePath, useTranslations, type Lang } from '../../../i18n/ui';
import { listedThemes, themeBySlug } from '../../../data/themes';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).flatMap((lang) =>
    listedThemes.map((theme) => ({ params: { lang, slug: theme.slug } })),
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const t = useTranslations(lang);
const theme = themeBySlug(slug)!;

// Um tema sem card próprio cai no genérico em vez de apontar para um 404 — um
// link compartilhado sem imagem é ruim, mas com a imagem do tema errado é pior.
const ogImage = existsSync(join(process.cwd(), 'public', 'og', `${slug}.png`))
  ? `/og/${slug}.png`
  : '/og/default.png';

// A página de um tema é pintada por ele. O Carmilla já é a paleta do site, então
// só os outros precisam reescrever as variáveis. O CSS do Papilio já emite os
// dois flavors; o script abaixo reaplica o escolhido antes da primeira pintura.
const paletteOverride = slug === 'vesperveil' ? vesperveilSiteCss() : slug === 'papilio' ? papilioSiteVars(':root') : slug === 'cinder' ? cinderSiteCss() : undefined;
const themeColorOverride = slug === 'vesperveil' ? vesperveil.deep : slug === 'papilio' ? papilioBg : slug === 'cinder' ? cinder.deep : undefined;
const papilioThemeColors =
  slug === 'papilio'
    ? Object.fromEntries(papilioFlavors().map((f) => [f.id, f.bg]))
    : null;
---

<Base
  title={`${theme.name} — ${theme.tagline[lang]}`}
  description={theme.summary[lang]}
  ogImage={ogImage}
  paletteOverride={paletteOverride}
  themeColorOverride={themeColorOverride}
>
  {
    papilioThemeColors && (
      <script is:inline define:vars={{ papilioThemeColors }}>
        {`(function () {
          try {
            var f = localStorage.getItem('papilio-flavor');
            if (f && papilioThemeColors[f]) {
              document.documentElement.dataset.flavor = f;
              var m = document.querySelector('meta[name="theme-color"]');
              if (m) m.setAttribute('content', papilioThemeColors[f]);
            }
          } catch (e) {}
        })();`}
      </script>
    )
  }
  <div class="wrap theme-detail">
    <header class="theme-hero">
      <p class="theme-meta">VS Code · v{theme.version}</p>
      {theme.icon && <img class="theme-icon" src={theme.icon} alt="" width="96" height="96" />}
      <h1>{theme.name}</h1>
      <div class="subtitle">{theme.tagline[lang]}</div>
      <p class="lead">{theme.summary[lang]}</p>
      {slug === 'carmilla' && <CarmillaFlavorSwitch />}
      <div class="hero-actions"><a href="#editor">{t('theme.preview')}</a><a href="#install">{t('theme.install.cta')}</a></div>
    </header>

    {slug === 'carmilla' && <CarmillaShowcase><ThemeInstallation slot="installation" theme={theme} lang={lang} /></CarmillaShowcase>}
    {slug === 'papilio' && <><ThemeInstallation theme={theme} lang={lang} /><PapilioShowcase /></>}
    {slug === 'cinder' && <CinderShowcase><ThemeInstallation slot="installation" theme={theme} lang={lang} /></CinderShowcase>}
    {slug === 'vesperveil' && <VesperveilShowcase><ThemeInstallation slot="installation" theme={theme} lang={lang} /></VesperveilShowcase>}

    {
      theme.disclaimer && (
        <p class="disclaimer">
          <strong>⚠</strong> {theme.disclaimer[lang]}
        </p>
      )
    }

    <p class="back">
      <a href={localePath(lang, '/themes/')}>← {t('theme.back')}</a>
    </p>
  </div>
</Base>

<style>
  .theme-icon { display: block; width: 48px; height: 48px; margin: 0 auto 1rem; border-radius: var(--radius-panel); }
  .theme-hero { text-align: center; padding: 0 0 2rem; }
  .theme-meta { font: var(--text-caption)/1.6 var(--font-mono); color: var(--ash-mauve); margin-bottom: 1rem; }
  .theme-hero h1 { font: 600 clamp(3.5rem, 8vw, 6.5rem)/1.05 var(--font-display); letter-spacing: -.035em; color: var(--pearl); margin-bottom: .8rem; overflow-wrap: anywhere; }
  .theme-hero .subtitle { font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.5; color: var(--wisteria); margin: 0 auto 1rem; max-width: 40ch; text-wrap: balance; }
  .theme-hero .lead { font-size: 1rem; max-width: 58ch; margin: 0 auto; color: rgba(var(--pearl-rgb), .86); line-height: 1.75; text-wrap: pretty; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
  .hero-actions a { display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: .3em; font-size: var(--text-small); }
  .hero-actions a:hover { color: var(--champagne); }

  .disclaimer {
    margin: 4rem auto 0;
    max-width: 70ch;
    padding: 1rem 1.3rem;
    border-radius: var(--radius-panel);
    background: rgba(var(--velvet-rgb), 0.5);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--ash-mauve);
  }
  .disclaimer strong {
    color: var(--champagne);
    margin-right: 0.3rem;
  }

  .back {
    margin-top: 5rem;
    text-align: center;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ash-mauve);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back a:hover {
    color: var(--carmine);
  }

  /* Ritmo comum às vitrines; os exemplos de código mantêm sua tipografia. */
  .theme-detail :global(.section-title) {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .theme-detail :global(.section-head) { margin-bottom: 1.25rem; }
  .theme-detail :global(.section-num) {
    font: 500 .8rem/1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .theme-detail :global(.section-subtitle) {
    font: 400 1rem/1.65 var(--font-body);
    margin-top: 0;
    margin-left: 0;
    margin-bottom: 1.5rem;
    text-wrap: pretty;
  }
  .theme-detail :global(.lead-text) {
    margin-left: 0;
    font-size: 1.0625rem;
    line-height: 1.8;
    max-width: 65ch;
    text-wrap: pretty;
  }
  .theme-detail :global(.btn) { font-size: .9rem; line-height: 1.5; }
</style>
