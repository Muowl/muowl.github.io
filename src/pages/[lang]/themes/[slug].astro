---
import Base from '../../../layouts/Base.astro';
import CarmillaShowcase from '../../../components/CarmillaShowcase.astro';
import PapilioShowcase from '../../../components/PapilioShowcase.astro';
import {
  siteVarsCss as papilioSiteVars,
  BG as papilioBg,
  flavors as papilioFlavors,
} from '../../../lib/papilio';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { languages, localePath, useTranslations, type Lang } from '../../../i18n/ui';
import { themes, themeBySlug } from '../../../data/themes';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).flatMap((lang) =>
    themes.map((theme) => ({ params: { lang, slug: theme.slug } })),
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const t = useTranslations(lang);
const theme = themeBySlug(slug)!;

// Um tema sem card próprio cai no genérico em vez de apontar para um 404 — um
// link compartilhado sem imagem é ruim, mas com a imagem do tema errado é pior.
const ogImage = existsSync(join(process.cwd(), 'public', 'og', `${slug}.png`))
  ? `/og/${slug}.png`
  : '/og/default.png';

// A página de um tema é pintada por ele. O Carmilla já é a paleta do site, então
// só os outros precisam reescrever as variáveis. O CSS do Papilio já emite os
// dois flavors; o script abaixo reaplica o escolhido antes da primeira pintura.
const paletteOverride = slug === 'papilio' ? papilioSiteVars(':root') : undefined;
const themeColorOverride = slug === 'papilio' ? papilioBg : undefined;
const papilioThemeColors =
  slug === 'papilio'
    ? Object.fromEntries(papilioFlavors().map((f) => [f.id, f.bg]))
    : null;
---

<Base
  title={`${theme.name} — ${theme.tagline[lang]}`}
  description={theme.summary[lang]}
  ogImage={ogImage}
  paletteOverride={paletteOverride}
  themeColorOverride={themeColorOverride}
>
  {
    papilioThemeColors && (
      <script is:inline define:vars={{ papilioThemeColors }}>
        {`(function () {
          try {
            var f = localStorage.getItem('papilio-flavor');
            if (f && papilioThemeColors[f]) {
              document.documentElement.dataset.flavor = f;
              var m = document.querySelector('meta[name="theme-color"]');
              if (m) m.setAttribute('content', papilioThemeColors[f]);
            }
          } catch (e) {}
        })();`}
      </script>
    )
  }
  <div class="wrap">
    <header class="theme-hero">
      <div class="eyebrow">
        {
          lang === 'pt'
            ? `Tema escuro · Paleta autoral · v${theme.version}`
            : `Dark theme · Original palette · v${theme.version}`
        }
        {!theme.published && <span class="wip">{t('theme.wip')}</span>}
      </div>
      <h1>{theme.name}</h1>
      <div class="subtitle">{theme.tagline[lang]}</div>
      <div class="ornament" aria-hidden="true">❦</div>
      <p class="lead">{theme.summary[lang]}</p>
      <div class="cta">
        {
          theme.marketplace && (
            <a class="btn btn-primary" href={theme.marketplace}>
              <svg
                viewBox="0 0 24 24"
                width="19"
                height="19"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3v10m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
              </svg>
              {t('theme.install')}
            </a>
          )
        }
        {theme.openVsx && <a class="btn btn-ghost" href={theme.openVsx}>{t('theme.openvsx')}</a>}
        <a class="btn btn-ghost" href={theme.repo}>
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
          {t('theme.github')}
        </a>
      </div>

      {!theme.published && <p class="wip-note">{t('theme.wip.note')}</p>}
    </header>

    {slug === 'carmilla' && <CarmillaShowcase />}
    {slug === 'papilio' && <PapilioShowcase />}

    {
      theme.disclaimer && (
        <p class="disclaimer">
          <strong>⚠</strong> {theme.disclaimer[lang]}
        </p>
      )
    }

    <p class="back">
      <a href={localePath(lang, '/themes/')}>← {t('theme.back')}</a>
    </p>
  </div>
</Base>

<style>
  .theme-hero {
    text-align: center;
    padding: 3rem 1rem 4rem;
  }

  .theme-hero .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ash-mauve);
    margin-bottom: 1.5rem;
  }

  .theme-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, var(--pearl) 0%, var(--carmine) 60%, var(--wisteria) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    margin-bottom: 1rem;
    text-shadow: 0 0 80px rgba(var(--carmine-rgb), 0.15);
  }

  .theme-hero .subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: var(--wisteria);
    margin-bottom: 2rem;
    opacity: 0.92;
  }

  .theme-hero .lead {
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto;
    color: rgba(var(--pearl-rgb), 0.78);
    line-height: 1.7;
  }

  .theme-hero .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.5rem;
  }

  .wip {
    display: inline-block;
    margin-left: 0.8rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgba(var(--carmine-rgb), 0.15);
    border: 1px solid rgba(var(--carmine-rgb), 0.4);
    color: var(--carmine);
    letter-spacing: 0.14em;
  }

  .wip-note {
    margin: 1.6rem auto 0;
    max-width: 46ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ash-mauve);
  }

  .disclaimer {
    margin: 4rem auto 0;
    max-width: 70ch;
    padding: 1rem 1.3rem;
    border-radius: 0.8rem;
    background: rgba(var(--velvet-rgb), 0.5);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ash-mauve);
  }
  .disclaimer strong {
    color: var(--champagne);
    margin-right: 0.3rem;
  }

  .back {
    margin-top: 5rem;
    text-align: center;
  }
  .back a {
    color: var(--ash-mauve);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .back a:hover {
    color: var(--carmine);
  }
</style>
