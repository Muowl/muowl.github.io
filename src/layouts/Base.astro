---
import { paletteCss, themeColor } from '../lib/palette';
import { studio, studioCss } from '../lib/studio';
import Owl from '../components/Owl.astro';
import Favicons from '../components/Favicons.astro';
import {
  getLangFromUrl,
  stripLang,
  localePath,
  localeTag,
  useTranslations,
  type Lang,
} from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Caminho da imagem social relativo à raiz. */
  ogImage?: string;
  noindex?: boolean;
  /**
   * CSS que reescreve as variáveis da paleta para esta página — é como a página
   * de um tema passa a ser pintada pelo próprio tema. Entra depois do bloco
   * padrão, então vence por ordem de origem.
   */
  paletteOverride?: string;
  /** Cor da barra do navegador, quando a página troca de paleta. */
  themeColorOverride?: string;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  noindex = false,
  paletteOverride,
  themeColorOverride,
} = Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const bare = stripLang(Astro.url.pathname);
const isShowcase = /^\/themes\/[^/]+\/$/.test(bare);

const site = Astro.site ?? new URL('https://muowl.dev');
const canonical = new URL(Astro.url.pathname, site);
const ogUrl = new URL(ogImage, site);

const nav = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.themes', path: '/themes/' },
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.about', path: '/about/' },
] as const;
---

<html lang={localeTag[lang]} data-flavor="base" data-studio={!isShowcase ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColorOverride ?? (isShowcase ? themeColor('base') : studio.paper)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(localePath('pt', bare), site).href} />
    <link rel="alternate" hreflang="en" href={new URL(localePath('en', bare), site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', bare), site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />

    <Favicons />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global set:html={paletteCss()}></style>
    {!isShowcase && <style is:global set:html={studioCss()}></style>}
    {/* Depois do bloco padrão de propósito: é a ordem que faz o override vencer. */}
    {paletteOverride && <style is:global set:html={paletteOverride}></style>}

    {
      /* Aplica o flavor salvo antes da primeira pintura, para não piscar.
         Numa página que troca de paleta o flavor do Carmilla não se aplica. */
      isShowcase && !paletteOverride && (
        <script is:inline define:vars={{ amethystCrypt: themeColor('amethyst') }}>
          (function () {
          try {
            var f = localStorage.getItem('carmilla-flavor');
            if (f === 'amethyst') {
              document.documentElement.dataset.flavor = f;
              var m = document.querySelector('meta[name="theme-color"]');
              if (m) m.setAttribute('content', amethystCrypt);
            }
          } catch (e) {}
          })();
        </script>
      )
    }
  </head>

  <body>
    <a class="skip" href="#content">{t('nav.skip')}</a>

    <header class="site-head">
      <a class="brand" href={localePath(lang, '/')}>
        <Owl class="brand-owl" />
        <span class="brand-name">muowl</span>
      </a>

      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          nav.map((item) => {
            const href = localePath(lang, item.path);
            const current = bare === item.path || (item.path !== '/' && bare.startsWith(item.path));
            return (
              <a href={href} aria-current={current ? 'page' : undefined}>
                {t(item.key)}
              </a>
            );
          })
        }
      </nav>

      <div class="lang-switch" role="group" aria-label={t('lang.label')}>
        <a href={localePath('pt', bare)} aria-current={lang === 'pt' ? 'true' : undefined}>PT</a>
        <a href={localePath('en', bare)} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-foot">
      <a class="footer-signature" href={localePath(lang, '/')} aria-label="muowl"><Owl class="footer-owl" /><span>muowl.</span></a>
      <p class="foot-meta">
        {t('footer.built')} ·
        <a href="https://github.com/Muowl">github.com/Muowl</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 8rem;
  }

  body {
    background: var(--crypt);
    font-family: var(--font-body);
    color: var(--pearl);
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  :root {
    --font-display: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    --font-body: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'IBM Plex Mono', 'Fira Code', 'SF Mono', monospace;
    --page-width: 1240px;
    --page-gutter: clamp(1.25rem, 4vw, 2.5rem);
    --radius-panel: .25rem;
    --radius-control: .25rem;
    --text-caption: .8125rem;
    --text-small: .9375rem;
    --border-panel: 1px solid rgba(var(--pearl-rgb), .16);
  }

  /* Grão sutil — atmosfera de filme antigo */
  .brand-owl { width: 32px; height: 32px; align-self: center; }
  .footer-signature { display: inline-flex; align-items: center; gap: .8rem; font: 500 3rem var(--font-display); text-decoration: none; margin-bottom: 1rem; }
  .footer-owl { width: 48px; height: 48px; }
  :focus-visible { outline: 2px solid var(--champagne); outline-offset: 4px; }
  html[data-studio] { color-scheme: dark; }
  html:not([data-studio]) { color-scheme: dark; }
  html[data-studio] body::after {
    z-index: 99;
    opacity: .28;
    background: repeating-linear-gradient(to bottom, transparent 0 3px, rgba(var(--pearl-rgb), .018) 4px);
  }
  html[data-studio] body::before { opacity: .018; mix-blend-mode: screen; }
  html[data-studio] .site-head { border-bottom-color: var(--selection); }
  html[data-studio] .site-head::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--carmine), var(--wisteria), var(--champagne));
    opacity: .9;
  }
  html[data-studio] .site-head::after {
    content: 'PLAY  ▸  MUOWL / SIDE A';
    position: absolute; right: clamp(1rem, 4vw, 2.5rem); bottom: -.8rem;
    padding: .1rem .5rem; background: var(--crypt); color: var(--champagne);
    font: .6875rem var(--font-mono); letter-spacing: .07em;
  }
  html[data-studio] .brand { font-family: var(--font-body); font-weight: 600; letter-spacing: -.06em; font-size: 1.55rem; }
  html[data-studio] .brand-name:hover { text-shadow: -1px 0 var(--wisteria), 1px 0 var(--carmine); }
  html[data-studio] .btn { box-shadow: none; font: 500 var(--text-caption)/1.5 var(--font-mono); letter-spacing: .025em; }
  html[data-studio] .btn-primary { color: var(--crypt); background: var(--champagne); border-color: var(--champagne); }
  html[data-studio] .btn-primary:hover { color: var(--crypt); background: var(--pearl); border-color: var(--pearl); }
  html[data-studio] .section-num { font-family: var(--font-mono); font-style: normal; font-size: .75rem; }
  html[data-studio] .section-subtitle { font-family: var(--font-body); font-size: 1rem; font-style: normal; }
  html[data-studio] .section-title { font-size: clamp(3rem, 6vw, 4.5rem); line-height: 1.08; text-wrap: balance; }
  html[data-studio] .lang-switch a { font-family: var(--font-mono); }
  html[data-studio] .site-nav a,
  html[data-studio] .foot-meta,
  html[data-studio] .lang-switch a { font-family: var(--font-mono); text-transform: uppercase; }
  html[data-studio] .site-nav a { font-size: var(--text-caption); letter-spacing: .025em; }
  html[data-studio] .section-subtitle,
  html[data-studio] .lead-text { margin-left: 0; }
  html[data-studio] .wrap > .section-head { margin-bottom: 1rem; }
  html[data-studio] ::selection { background: var(--selection); color: var(--pearl); }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    opacity: 0.06;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    mix-blend-mode: overlay;
  }

  /* Glow ambiente */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 50% at 20% 0%, rgba(var(--carmine-rgb), 0.1), transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 100%, rgba(var(--wisteria-rgb), 0.08), transparent 60%);
  }

  a {
    color: inherit;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 300;
    background: var(--carmine);
    color: var(--crypt);
    padding: 0.7rem 1.2rem;
    border-radius: 0 0 var(--radius-control) 0;
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    left: 0;
  }

  /* ============== HEADER ============== */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: .75rem max(var(--page-gutter), calc((100vw - var(--page-width)) / 2 + var(--page-gutter)));
    background: rgba(var(--crypt-rgb), .94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(var(--carmine-rgb), 0.14);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--pearl);
  }
  .brand-mark {
    color: var(--carmine);
    font-size: 1rem;
  }
  .brand:hover .brand-name {
    color: var(--carmine);
  }
  .brand-name {
    transition: color 0.2s;
  }

  .site-nav {
    display: flex;
    gap: .35rem;
    margin-left: auto;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ash-mauve);
    padding: .5rem .85rem;
    border-radius: var(--radius-control);
    border-bottom: 2px solid transparent;
    transition: color .2s, border-color .2s, background .2s;
  }
  .site-nav a:hover {
    color: var(--pearl);
    background: rgba(var(--velvet-rgb), .65);
  }
  .site-nav a[aria-current='page'] {
    color: var(--pearl);
    border-bottom-color: var(--carmine);
    background: rgba(var(--velvet-rgb), .65);
  }

  .lang-switch {
    display: flex;
    gap: 0.15rem;
    padding: .15rem;
    border-radius: var(--radius-control);
    background: rgba(var(--velvet-rgb), 0.72);
    border: 1px solid rgba(var(--carmine-rgb), 0.18);
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ash-mauve);
    text-decoration: none;
    padding: .4rem .65rem;
    border-radius: var(--radius-control);
    transition: color 0.2s, background 0.2s;
  }
  .lang-switch a:hover {
    color: var(--pearl);
  }
  .lang-switch a[aria-current='true'] {
    background: var(--carmine);
    color: var(--crypt);
  }

  /* ============== ESTRUTURA ============== */
  main {
    flex: 1;
  }

  .wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--page-gutter) 5rem;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2rem auto;
    color: var(--carmine);
    font-size: 1.2rem;
  }
  .ornament::before,
  .ornament::after {
    content: '';
    display: block;
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--carmine), transparent);
  }

  section {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .section-head {
    margin-bottom: 2.5rem;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .section-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--carmine);
    min-width: 50px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 500;
    color: var(--pearl);
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    margin-left: 66px;
    color: var(--ash-mauve);
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin-top: -0.5rem;
    margin-bottom: 1rem;
  }

  .lead-text {
    margin-left: 66px;
    max-width: 760px;
    color: rgba(var(--pearl-rgb), .84);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* ============== BOTÕES ============== */
  .btn {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    min-height: 48px;
    padding: .8rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease,
      border-color 0.2s ease;
  }

  .btn-primary {
    background: var(--carmine);
    color: var(--crypt);
    box-shadow: 0 8px 30px -8px rgba(var(--carmine-rgb), 0.5);
  }
  .btn-primary:hover {
    background: var(--carmine-hover);
    box-shadow: 0 12px 38px -8px rgba(var(--carmine-rgb), 0.65);
  }

  .btn-ghost {
    color: var(--pearl);
    background: rgba(var(--velvet-rgb), 0.35);
    border: 1px solid rgba(var(--carmine-rgb), 0.4);
  }
  .btn-ghost:hover {
    border-color: var(--carmine);
    background: rgba(var(--velvet-rgb), 0.7);
  }

  /* ============== FOOTER ============== */
  .site-foot {
    padding: 2.5rem var(--page-gutter);
    text-align: center;
    border-top: 1px solid rgba(var(--carmine-rgb), 0.15);
  }
  .foot-meta {
    color: var(--ash-mauve);
    font-size: var(--text-caption);
    line-height: 1.9;
  }
  .foot-meta a {
    color: var(--carmine);
    text-decoration: none;
  }
  .foot-meta a:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .site-head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .5rem 1rem;
      padding-block: .65rem;
    }
    .lang-switch { justify-self: end; }
    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      width: 100%;
      margin-left: 0;
      gap: .25rem;
    }
    .site-nav a { padding-inline: .25rem; }
    html { scroll-padding-top: 10rem; }
  }

  @media (max-width: 680px) {
    .wrap {
      padding-block: 2.75rem 3.5rem;
    }
    section {
      margin-top: 4rem;
    }
    .section-title {
      font-size: 1.8rem;
    }
    .section-subtitle,
    .lead-text {
      margin-left: 0;
    }
    .section-head {
      flex-direction: column;
      gap: 0.5rem;
    }
    .section-num {
      min-width: auto;
    }
  }
</style>
